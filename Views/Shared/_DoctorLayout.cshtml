@using System.Security.Claims
@{
    var firstName = User.FindFirstValue(ClaimTypes.GivenName) ?? "Doctor";
    var lastName = User.FindFirstValue(ClaimTypes.Surname) ?? "";
    var initials = (firstName.Length > 0 ? firstName[0].ToString() : "") +
                     (lastName.Length > 0 ? lastName[0].ToString() : "");
    var currentPath = Context.Request.Path.Value ?? "";
    string Nav(string path) => currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase)
        ? "nav-item active" : "nav-item";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – NMB-HLabSys Doctor</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        /* ═══════════════════════════════════════════════════
                   DESIGN TOKENS
                ═══════════════════════════════════════════════════ */
        :root {
            --navy: #0A1628;
            --navy-mid: #0F2040;
            --navy-light: #162d52;
            --teal: #0ECECE;
            --teal-dark: #09a8a8;
            --teal-glow: rgba(14,206,206,.18);
            --white: #FFFFFF;
            --off-white: #e8f0f7;
            --muted: #7a99bb;
            --danger: #f25c5c;
            --warning: #f5a623;
            --success: #2ecc71;
            --card-bg: rgba(15,32,64,.75);
            --border: rgba(14,206,206,.18);
            --border-soft: rgba(255,255,255,.07);
            --sidebar-w: 260px;
            --topbar-h: 64px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
            font-family: 'Outfit', sans-serif;
            background: var(--navy);
            color: var(--white);
            overflow-x: hidden;
        }

            body::before {
                content: '';
                position: fixed;
                inset: 0;
                z-index: -1;
                background: linear-gradient(135deg, #060e1c 0%, #0A1628 55%, #0d2040 100%);
            }

            body::after {
                content: '';
                position: fixed;
                inset: 0;
                z-index: -1;
                background-image: linear-gradient(rgba(14,206,206,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(14,206,206,.03) 1px, transparent 1px);
                background-size: 60px 60px;
            }

        /* SIDEBAR */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: var(--sidebar-w);
            background: rgba(10,22,40,.95);
            border-right: 1px solid var(--border-soft);
            display: flex;
            flex-direction: column;
            z-index: 100;
            backdrop-filter: blur(20px);
            transition: transform .3s ease;
        }

        .sidebar-brand {
            padding: 20px 20px 18px;
            border-bottom: 1px solid var(--border-soft);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            border-radius: 11px;
            flex-shrink: 0;
            background: linear-gradient(135deg, var(--teal), var(--teal-dark));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            color: var(--navy);
            box-shadow: 0 0 16px var(--teal-glow);
        }

        .brand-text .b-name {
            font-size: .88rem;
            font-weight: 700;
            letter-spacing: .04em;
            color: var(--white);
        }

        .brand-text .b-sub {
            font-size: .66rem;
            font-weight: 400;
            color: var(--muted);
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .sidebar-nav {
            flex: 1;
            overflow-y: auto;
            padding: 12px 10px;
            scrollbar-width: thin;
            scrollbar-color: rgba(14,206,206,.2) transparent;
        }

        .nav-section-label {
            font-size: .62rem;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: rgba(122,153,187,.5);
            padding: 14px 10px 6px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: .84rem;
            font-weight: 500;
            color: var(--muted);
            text-decoration: none;
            cursor: pointer;
            transition: background .2s, color .2s;
            margin-bottom: 2px;
            position: relative;
        }

            .nav-item i {
                width: 18px;
                text-align: center;
                font-size: .85rem;
                flex-shrink: 0;
            }

            .nav-item:hover {
                background: rgba(14,206,206,.08);
                color: var(--off-white);
            }

            .nav-item.active {
                background: rgba(14,206,206,.12);
                color: var(--teal);
                border: 1px solid rgba(14,206,206,.18);
            }

                .nav-item.active i {
                    color: var(--teal);
                }

                .nav-item.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 20%;
                    bottom: 20%;
                    width: 3px;
                    border-radius: 0 3px 3px 0;
                    background: var(--teal);
                }

        .nav-badge {
            margin-left: auto;
            min-width: 20px;
            height: 20px;
            border-radius: 10px;
            background: rgba(242,92,92,.15);
            border: 1px solid rgba(242,92,92,.3);
            color: var(--danger);
            font-size: .66rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 5px;
        }

        .sidebar-footer {
            padding: 14px 10px;
            border-top: 1px solid var(--border-soft);
        }

        .user-card {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 11px;
            background: rgba(14,206,206,.05);
            border: 1px solid var(--border);
        }

        .avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            flex-shrink: 0;
            background: linear-gradient(135deg, var(--teal), var(--teal-dark));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .78rem;
            font-weight: 800;
            color: var(--navy);
        }

        .user-info .u-name {
            font-size: .82rem;
            font-weight: 600;
            color: var(--off-white);
        }

        .user-info .u-role {
            font-size: .7rem;
            color: var(--muted);
        }

        .logout-btn {
            margin-left: auto;
            background: none;
            border: none;
            color: var(--muted);
            cursor: pointer;
            font-size: .85rem;
            padding: 4px 6px;
            border-radius: 7px;
            transition: color .2s, background .2s;
        }

            .logout-btn:hover {
                color: var(--danger);
                background: rgba(242,92,92,.1);
            }

        /* TOPBAR */
        .topbar {
            position: fixed;
            top: 0;
            left: var(--sidebar-w);
            right: 0;
            height: var(--topbar-h);
            background: rgba(10,22,40,.85);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border-soft);
            display: flex;
            align-items: center;
            padding: 0 28px;
            gap: 16px;
            z-index: 99;
        }

        .menu-toggle {
            display: none;
            background: none;
            border: none;
            color: var(--muted);
            font-size: 1.2rem;
            cursor: pointer;
        }

        .topbar-title {
            font-size: 1rem;
            font-weight: 600;
            color: var(--off-white);
            flex: 1;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .topbar-btn {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: rgba(255,255,255,.05);
            border: 1px solid rgba(255,255,255,.08);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--muted);
            font-size: .88rem;
            cursor: pointer;
            transition: background .2s, color .2s;
            text-decoration: none;
        }

            .topbar-btn:hover {
                background: rgba(14,206,206,.1);
                color: var(--teal);
            }

        /* MAIN */
        .main-content {
            margin-left: var(--sidebar-w);
            padding-top: var(--topbar-h);
            min-height: 100vh;
        }

        .content-area {
            padding: 32px 32px 48px;
        }

        .page-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 28px;
            flex-wrap: wrap;
            gap: 14px;
        }

        .page-header-left h1 {
            font-size: 1.55rem;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .page-header-left .page-sub {
            font-size: .84rem;
            color: var(--muted);
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 28px;
            backdrop-filter: blur(20px);
            box-shadow: 0 8px 32px rgba(0,0,0,.25);
        }

            .card + .card {
                margin-top: 20px;
            }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 20px 22px;
            display: flex;
            align-items: center;
            gap: 16px;
            backdrop-filter: blur(16px);
        }

        .stat-icon {
            width: 46px;
            height: 46px;
            border-radius: 13px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

            .stat-icon.teal {
                background: rgba(14,206,206,.12);
                color: var(--teal);
            }

            .stat-icon.warn {
                background: rgba(245,166,35,.12);
                color: var(--warning);
            }

            .stat-icon.danger {
                background: rgba(242,92,92,.12);
                color: var(--danger);
            }

        .stat-val {
            font-size: 1.55rem;
            font-weight: 700;
            line-height: 1;
            margin-bottom: 3px;
        }

        .stat-label {
            font-size: .78rem;
            color: var(--muted);
        }

        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: .875rem;
        }

        thead th {
            text-align: left;
            padding: 10px 14px;
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--muted);
            border-bottom: 1px solid var(--border-soft);
        }

        tbody tr {
            border-bottom: 1px solid var(--border-soft);
            transition: background .15s;
        }

            tbody tr:hover {
                background: rgba(14,206,206,.04);
            }

        tbody td {
            padding: 13px 14px;
            color: var(--off-white);
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: .72rem;
            font-weight: 600;
            letter-spacing: .04em;
        }

        .badge-teal {
            background: rgba(14,206,206,.12);
            color: var(--teal);
            border: 1px solid rgba(14,206,206,.25);
        }

        .badge-green {
            background: rgba(46,204,113,.12);
            color: var(--success);
            border: 1px solid rgba(46,204,113,.25);
        }

        .badge-warn {
            background: rgba(245,166,35,.12);
            color: var(--warning);
            border: 1px solid rgba(245,166,35,.25);
        }

        .badge-danger {
            background: rgba(242,92,92,.12);
            color: var(--danger);
            border: 1px solid rgba(242,92,92,.25);
        }

        .badge-muted {
            background: rgba(122,153,187,.1);
            color: var(--muted);
            border: 1px solid rgba(122,153,187,.2);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 16px;
            border-radius: 9px;
            border: none;
            font-family: 'Outfit', sans-serif;
            font-size: .84rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: transform .15s, box-shadow .2s, filter .2s;
            white-space: nowrap;
        }

            .btn:hover {
                transform: translateY(-1px);
            }

            .btn:active {
                transform: none;
            }

        .btn-primary {
            background: linear-gradient(135deg, var(--teal), var(--teal-dark));
            color: var(--navy);
            box-shadow: 0 3px 14px rgba(14,206,206,.3);
        }

        .btn-secondary {
            background: rgba(14,206,206,.08);
            color: var(--teal);
            border: 1px solid rgba(14,206,206,.25);
        }

        .btn-danger {
            background: rgba(242,92,92,.1);
            color: var(--danger);
            border: 1px solid rgba(242,92,92,.25);
        }

        .btn-warning {
            background: rgba(245,166,35,.1);
            color: var(--warning);
            border: 1px solid rgba(245,166,35,.25);
        }

        .btn-ghost {
            background: rgba(255,255,255,.05);
            color: var(--muted);
            border: 1px solid rgba(255,255,255,.1);
        }

        .btn-sm {
            padding: 5px 11px;
            font-size: .78rem;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px 22px;
        }

            .form-grid .full {
                grid-column: 1 / -1;
            }

        .form-group {
            margin-bottom: 18px;
        }

        .form-label {
            display: block;
            font-size: .76rem;
            font-weight: 600;
            letter-spacing: .07em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 7px;
        }

        .form-control, .form-select {
            width: 100%;
            padding: 11px 14px;
            background: rgba(255,255,255,.05);
            border: 1.5px solid rgba(255,255,255,.1);
            border-radius: 11px;
            color: var(--white);
            font-family: 'Outfit', sans-serif;
            font-size: .9rem;
            outline: none;
            transition: border-color .25s, box-shadow .25s;
            appearance: none;
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--teal);
                background: rgba(14,206,206,.05);
                box-shadow: 0 0 0 3px rgba(14,206,206,.12);
            }

        .text-danger {
            font-size: .78rem;
            color: var(--danger);
            margin-top: 5px;
        }

        .alert {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 14px 18px;
            border-radius: 12px;
            margin-bottom: 20px;
        }

        .alert-success {
            background: rgba(46,204,113,.08);
            border: 1px solid rgba(46,204,113,.25);
            color: var(--success);
        }

        .alert-danger {
            background: rgba(242,92,92,.08);
            border: 1px solid rgba(242,92,92,.25);
            color: var(--danger);
        }

        .alert-info {
            background: rgba(14,206,206,.06);
            border: 1px solid rgba(14,206,206,.2);
            color: var(--teal);
        }

        .search-bar {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }

        .search-wrap {
            position: relative;
            flex: 1;
            min-width: 200px;
        }

            .search-wrap i {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--muted);
                font-size: .82rem;
            }

            .search-wrap input {
                width: 100%;
                padding: 9px 12px 9px 36px;
                background: rgba(255,255,255,.05);
                border: 1.5px solid rgba(255,255,255,.1);
                border-radius: 10px;
                color: var(--white);
                font-family: 'Outfit', sans-serif;
                font-size: .88rem;
                outline: none;
            }

        @@media (max-width: 900px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main-content {
                margin-left: 0;
            }

            .topbar {
                left: 0;
            }

            .menu-toggle {
                display: block;
            }

            .content-area {
                padding: 24px 18px 48px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }
        }

        .dropdown-item:hover {
            background: rgba(14,206,206,.08);
            color: var(--off-white) !important;
        }

    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon"><i class="fas fa-flask"></i></div>
            <div class="brand-text">
                <div class="b-name">NMB-HLabSys</div>
                <div class="b-sub">Doctor Portal</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section-label">Overview</div>
            <a class="@Nav("/Doctor/Dashboard")" asp-controller="Doctor" asp-action="Dashboard">
                <i class="fas fa-gauge-high"></i> Dashboard
            </a>

            <div class="nav-section-label">Patients</div>
            <a class="@Nav("/Doctor/Patients")" asp-controller="Doctor" asp-action="Patients">
                <i class="fas fa-users"></i> All Patients
            </a>
            <a class="@Nav("/Doctor/RegisterPatient")" asp-controller="Doctor" asp-action="RegisterPatient">
                <i class="fas fa-user-plus"></i> Register New Patient
            </a>
            <a class="@Nav("/Doctor/InactivePatients")" asp-controller="Doctor" asp-action="InactivePatients">
                <i class="fas fa-user-slash"></i> Inactive Patients
            </a>

            <div class="nav-section-label">Test Requests</div>
            <a class="@Nav("/Doctor/TestRequests")" asp-controller="Doctor" asp-action="TestRequests">
                <i class="fas fa-file-medical"></i> My Requests
            </a>
            <a class="@Nav("/Doctor/CreateTestRequest")" asp-controller="Doctor" asp-action="CreateTestRequest">
                <i class="fas fa-plus-circle"></i> New Request
            </a>
            <a class="@Nav("/Doctor/InactiveTestRequests")" asp-controller="Doctor" asp-action="InactiveTestRequests">
                <i class="fas fa-archive"></i> Archived Requests
            </a>

            <div class="nav-section-label">Results</div>
            <a class="@Nav("/Doctor/Alerts")" asp-controller="Doctor" asp-action="Alerts">
                <i class="fas fa-exclamation-triangle"></i> Abnormal Alerts
                @if (ViewBag.AlertCount != null && (int)ViewBag.AlertCount > 0)
                {
                    <span class="nav-badge">@ViewBag.AlertCount</span>
                }
            </a>
            <a class="@Nav("/Doctor/TestRequestsReport")" asp-controller="Doctor" asp-action="TestRequestsReport">
                <i class="fas fa-file-pdf"></i> Reports
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="user-card">
                <div class="avatar">@initials</div>
                <div class="user-info">
                    <div class="u-name">@firstName @lastName</div>
                    <div class="u-role">Doctor</div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="logout-btn" title="Sign Out">
                        <i class="fas fa-right-from-bracket"></i>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- TOPBAR -->
    <!-- Replace the existing .topbar-actions div with this -->
    <div class="topbar-actions">
        <div class="dropdown" style="position:relative;">
            <button class="topbar-btn" type="button" id="userDropdownBtn" onclick="toggleDropdown()" style="display:flex;align-items:center;gap:6px;width:auto;padding:0 12px;">
                <i class="fas fa-user-circle"></i>
                <span style="font-size:.8rem;">@firstName</span>
                <i class="fas fa-chevron-down" style="font-size:.7rem;"></i>
            </button>
            <div id="userDropdown" class="dropdown-menu" style="display:none;position:absolute;right:0;top:50px;background:var(--navy-mid);border:1px solid var(--border);border-radius:12px;padding:8px 0;min-width:180px;z-index:200;box-shadow:0 8px 24px rgba(0,0,0,.5);">
                <a asp-action="EditProfile" asp-controller="Account" class="dropdown-item" style="display:flex;align-items:center;gap:10px;padding:10px 16px;color:var(--muted);text-decoration:none;transition:background .2s;">
                    <i class="fas fa-pen"></i> Edit Profile
                </a>
                <a asp-action="ChangePassword" asp-controller="Account" class="dropdown-item" style="display:flex;align-items:center;gap:10px;padding:10px 16px;color:var(--muted);text-decoration:none;transition:background .2s;">
                    <i class="fas fa-lock"></i> Change Password
                </a>
                <div style="border-top:1px solid var(--border-soft);margin:6px 0;"></div>
                <form asp-action="DeactivateAccount" asp-controller="Account" method="post" onsubmit="return confirm('Are you sure you want to deactivate your account? You will be logged out and unable to sign in until an administrator reactivates you.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item" style="display:flex;align-items:center;gap:10px;padding:10px 16px;color:var(--danger);background:none;border:none;width:100%;text-align:left;cursor:pointer;font-family:'Outfit',sans-serif;font-size:.84rem;">
                        <i class="fas fa-user-slash"></i> Deactivate Account
                    </button>
                </form>
                <div style="border-top:1px solid var(--border-soft);margin:6px 0;"></div>
                <form asp-action="Logout" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item" style="display:flex;align-items:center;gap:10px;padding:10px 16px;color:var(--muted);background:none;border:none;width:100%;text-align:left;cursor:pointer;font-family:'Outfit',sans-serif;font-size:.84rem;">
                        <i class="fas fa-right-from-bracket"></i> Sign Out
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- MAIN -->
    <main class="main-content">
        <div class="content-area">
            <partial name="_Alerts" />
            @RenderBody()
        </div>
    </main>

    <div id="sidebarOverlay" onclick="toggleSidebar()"
         style="display:none;position:fixed;inset:0;z-index:99;background:rgba(0,0,0,.5);"></div>

    <script>
        function toggleSidebar() {
            const sb = document.getElementById('sidebar');
            const ov = document.getElementById('sidebarOverlay');
            sb.classList.toggle('open');
            ov.style.display = sb.classList.contains('open') ? 'block' : 'none';
        }
        document.querySelectorAll('.alert').forEach(a => {
            setTimeout(() => { a.style.opacity = '0'; setTimeout(() => a.remove(), 500); }, 4000);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>
</html>