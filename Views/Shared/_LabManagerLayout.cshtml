@using System.Security.Claims
@{
    var firstName  = User.FindFirstValue(ClaimTypes.GivenName) ?? "Manager";
    var lastName   = User.FindFirstValue(ClaimTypes.Surname)  ?? "";
    var initials   = (firstName.Length > 0 ? firstName[0].ToString() : "") +
                     (lastName.Length  > 0 ? lastName[0].ToString()  : "");
    var currentPath = Context.Request.Path.Value ?? "";
    string Nav(string path) => currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase)
        ? "nav-item active" : "nav-item";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        /* ═══════════════════════════════════════════════════
           DESIGN TOKENS
        ═══════════════════════════════════════════════════ */
        :root {
            --navy:        #0A1628;
            --navy-mid:    #0F2040;
            --navy-light:  #162d52;
            --teal:        #0ECECE;
            --teal-dark:   #09a8a8;
            --teal-glow:   rgba(14,206,206,.18);
            --white:       #FFFFFF;
            --off-white:   #e8f0f7;
            --muted:       #7a99bb;
            --danger:      #f25c5c;
            --warning:     #f5a623;
            --success:     #2ecc71;
            --card-bg:     rgba(15,32,64,.75);
            --border:      rgba(14,206,206,.18);
            --border-soft: rgba(255,255,255,.07);
            --sidebar-w:   260px;
            --topbar-h:    64px;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            height: 100%; font-family: 'Outfit', sans-serif;
            background: var(--navy); color: var(--white);
            overflow-x: hidden;
        }

        /* ── BG ── */
        body::before {
            content: '';
            position: fixed; inset: 0; z-index: -1;
            background: linear-gradient(135deg, #060e1c 0%, #0A1628 55%, #0d2040 100%);
        }

        body::after {
            content: '';
            position: fixed; inset: 0; z-index: -1;
            background-image:
                linear-gradient(rgba(14,206,206,.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(14,206,206,.03) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        /* ═══════════════════════════════════════════════════
           SIDEBAR
        ═══════════════════════════════════════════════════ */
        .sidebar {
            position: fixed; top: 0; left: 0; bottom: 0;
            width: var(--sidebar-w);
            background: rgba(10,22,40,.95);
            border-right: 1px solid var(--border-soft);
            display: flex; flex-direction: column;
            z-index: 100;
            backdrop-filter: blur(20px);
            transition: transform .3s ease;
        }

        .sidebar-brand {
            padding: 20px 20px 18px;
            border-bottom: 1px solid var(--border-soft);
            display: flex; align-items: center; gap: 12px;
        }

        .brand-icon {
            width: 40px; height: 40px; border-radius: 11px; flex-shrink: 0;
            background: linear-gradient(135deg, var(--teal), var(--teal-dark));
            display: flex; align-items: center; justify-content: center;
            font-size: 17px; color: var(--navy);
            box-shadow: 0 0 16px var(--teal-glow);
        }

        .brand-text .b-name {
            font-size: .88rem; font-weight: 700; letter-spacing: .04em; color: var(--white);
        }

        .brand-text .b-sub {
            font-size: .66rem; font-weight: 400; color: var(--muted);
            letter-spacing: .06em; text-transform: uppercase;
        }

        /* NAV */
        .sidebar-nav {
            flex: 1; overflow-y: auto; padding: 12px 10px;
            scrollbar-width: thin; scrollbar-color: rgba(14,206,206,.2) transparent;
        }

        .nav-section-label {
            font-size: .62rem; font-weight: 700; letter-spacing: .12em;
            text-transform: uppercase; color: rgba(122,153,187,.5);
            padding: 14px 10px 6px;
        }

        .nav-item {
            display: flex; align-items: center; gap: 11px;
            padding: 10px 12px; border-radius: 10px;
            font-size: .84rem; font-weight: 500; color: var(--muted);
            text-decoration: none; cursor: pointer;
            transition: background .2s, color .2s;
            margin-bottom: 2px; position: relative;
        }

        .nav-item i { width: 18px; text-align: center; font-size: .85rem; flex-shrink: 0; }

        .nav-item:hover  { background: rgba(14,206,206,.08); color: var(--off-white); }

        .nav-item.active {
            background: rgba(14,206,206,.12);
            color: var(--teal);
            border: 1px solid rgba(14,206,206,.18);
        }

        .nav-item.active i { color: var(--teal); }

        .nav-item.active::before {
            content: ''; position: absolute; left: 0; top: 20%; bottom: 20%;
            width: 3px; border-radius: 0 3px 3px 0;
            background: var(--teal);
        }

        /* Badge */
        .nav-badge {
            margin-left: auto; min-width: 20px; height: 20px; border-radius: 10px;
            background: rgba(242,92,92,.15); border: 1px solid rgba(242,92,92,.3);
            color: var(--danger); font-size: .66rem; font-weight: 700;
            display: flex; align-items: center; justify-content: center; padding: 0 5px;
        }

        /* sidebar footer */
        .sidebar-footer {
            padding: 14px 10px;
            border-top: 1px solid var(--border-soft);
        }

        .user-card {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 12px; border-radius: 11px;
            background: rgba(14,206,206,.05); border: 1px solid var(--border);
        }

        .avatar {
            width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;
            background: linear-gradient(135deg, var(--teal), var(--teal-dark));
            display: flex; align-items: center; justify-content: center;
            font-size: .78rem; font-weight: 800; color: var(--navy);
        }

        .user-info .u-name { font-size: .82rem; font-weight: 600; color: var(--off-white); }
        .user-info .u-role { font-size: .7rem; color: var(--muted); }

        .logout-btn {
            margin-left: auto; background: none; border: none;
            color: var(--muted); cursor: pointer; font-size: .85rem;
            padding: 4px 6px; border-radius: 7px; transition: color .2s, background .2s;
        }

        .logout-btn:hover { color: var(--danger); background: rgba(242,92,92,.1); }

        /* ═══════════════════════════════════════════════════
           TOPBAR
        ═══════════════════════════════════════════════════ */
        .topbar {
            position: fixed; top: 0; left: var(--sidebar-w); right: 0;
            height: var(--topbar-h);
            background: rgba(10,22,40,.85); backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border-soft);
            display: flex; align-items: center; padding: 0 28px; gap: 16px;
            z-index: 99;
        }

        .menu-toggle {
            display: none; background: none; border: none;
            color: var(--muted); font-size: 1.2rem; cursor: pointer;
        }

        .topbar-title {
            font-size: 1rem; font-weight: 600; color: var(--off-white);
            flex: 1;
        }

        .topbar-title span { color: var(--teal); }

        /* breadcrumb */
        .breadcrumb {
            display: flex; align-items: center; gap: 6px;
            font-size: .78rem; color: var(--muted);
        }

        .breadcrumb a { color: var(--muted); text-decoration: none; transition: color .2s; }
        .breadcrumb a:hover { color: var(--teal); }
        .breadcrumb .sep { font-size: .6rem; opacity: .5; }

        /* notification bell */
        .topbar-actions {
            display: flex; align-items: center; gap: 12px;
        }

        .topbar-btn {
            width: 36px; height: 36px; border-radius: 10px;
            background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08);
            display: flex; align-items: center; justify-content: center;
            color: var(--muted); font-size: .88rem; cursor: pointer;
            transition: background .2s, color .2s; text-decoration: none;
        }

        .topbar-btn:hover { background: rgba(14,206,206,.1); color: var(--teal); }

        /* ═══════════════════════════════════════════════════
           MAIN CONTENT
        ═══════════════════════════════════════════════════ */
        .main-content {
            margin-left: var(--sidebar-w);
            padding-top: var(--topbar-h);
            min-height: 100vh;
        }

        .content-area {
            padding: 32px 32px 48px;
        }

        /* ── PAGE HEADER ── */
        .page-header {
            display: flex; align-items: flex-start; justify-content: space-between;
            margin-bottom: 28px; flex-wrap: wrap; gap: 14px;
        }

        .page-header-left h1 {
            font-size: 1.55rem; font-weight: 700; margin-bottom: 4px;
        }

        .page-header-left .page-sub {
            font-size: .84rem; color: var(--muted);
        }

        /* ── CARDS ── */
        .card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 28px;
            backdrop-filter: blur(20px);
            box-shadow: 0 8px 32px rgba(0,0,0,.25);
        }

        .card + .card { margin-top: 20px; }

        /* ── STAT CARDS ── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px; margin-bottom: 24px;
        }

        .stat-card {
            background: var(--card-bg); border: 1px solid var(--border);
            border-radius: 16px; padding: 20px 22px;
            display: flex; align-items: center; gap: 16px;
            backdrop-filter: blur(16px);
            transition: transform .2s, box-shadow .2s;
        }

        .stat-card:hover { transform: translateY(-2px); box-shadow: 0 12px 36px rgba(0,0,0,.3); }

        .stat-icon {
            width: 46px; height: 46px; border-radius: 13px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px;
        }

        .stat-icon.teal  { background: rgba(14,206,206,.12); color: var(--teal); }
        .stat-icon.warn  { background: rgba(245,166,35,.12); color: var(--warning); }
        .stat-icon.danger{ background: rgba(242,92,92,.12);  color: var(--danger); }
        .stat-icon.green { background: rgba(46,204,113,.12); color: var(--success); }

        .stat-val  { font-size: 1.55rem; font-weight: 700; line-height: 1; margin-bottom: 3px; }
        .stat-label{ font-size: .78rem; color: var(--muted); }

        /* ── TABLE ── */
        .table-wrap { overflow-x: auto; }

        table {
            width: 100%; border-collapse: collapse; font-size: .875rem;
        }

        thead th {
            text-align: left; padding: 10px 14px;
            font-size: .72rem; font-weight: 700; letter-spacing: .08em;
            text-transform: uppercase; color: var(--muted);
            border-bottom: 1px solid var(--border-soft);
            white-space: nowrap;
        }

        tbody tr {
            border-bottom: 1px solid var(--border-soft);
            transition: background .15s;
        }

        tbody tr:hover { background: rgba(14,206,206,.04); }
        tbody tr:last-child { border-bottom: none; }

        tbody td { padding: 13px 14px; color: var(--off-white); vertical-align: middle; }

        .td-muted { color: var(--muted); font-size: .82rem; }

        /* ── BADGES ── */
        .badge {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 3px 10px; border-radius: 20px;
            font-size: .72rem; font-weight: 600; letter-spacing: .04em;
        }

        .badge-teal   { background: rgba(14,206,206,.12); color: var(--teal); border: 1px solid rgba(14,206,206,.25); }
        .badge-green  { background: rgba(46,204,113,.12); color: var(--success); border: 1px solid rgba(46,204,113,.25); }
        .badge-warn   { background: rgba(245,166,35,.12); color: var(--warning); border: 1px solid rgba(245,166,35,.25); }
        .badge-danger { background: rgba(242,92,92,.12);  color: var(--danger);  border: 1px solid rgba(242,92,92,.25); }
        .badge-muted  { background: rgba(122,153,187,.1); color: var(--muted);   border: 1px solid rgba(122,153,187,.2); }

        /* ── ACTION BUTTONS ── */
        .btn {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 8px 16px; border-radius: 9px; border: none;
            font-family: 'Outfit', sans-serif; font-size: .84rem; font-weight: 600;
            cursor: pointer; text-decoration: none;
            transition: transform .15s, box-shadow .2s, filter .2s, opacity .2s;
            white-space: nowrap;
        }

        .btn:hover { transform: translateY(-1px); }
        .btn:active { transform: none; }

        .btn-primary {
            background: linear-gradient(135deg, var(--teal), var(--teal-dark));
            color: var(--navy);
            box-shadow: 0 3px 14px rgba(14,206,206,.3);
        }

        .btn-primary:hover { filter: brightness(1.07); box-shadow: 0 6px 20px rgba(14,206,206,.45); }

        .btn-secondary {
            background: rgba(14,206,206,.08); color: var(--teal);
            border: 1px solid rgba(14,206,206,.25);
        }

        .btn-secondary:hover { background: rgba(14,206,206,.15); }

        .btn-danger {
            background: rgba(242,92,92,.1); color: var(--danger);
            border: 1px solid rgba(242,92,92,.25);
        }

        .btn-danger:hover { background: rgba(242,92,92,.2); }

        .btn-warning {
            background: rgba(245,166,35,.1); color: var(--warning);
            border: 1px solid rgba(245,166,35,.25);
        }

        .btn-warning:hover { background: rgba(245,166,35,.2); }

        .btn-ghost {
            background: rgba(255,255,255,.05); color: var(--muted);
            border: 1px solid rgba(255,255,255,.1);
        }

        .btn-ghost:hover { color: var(--off-white); background: rgba(255,255,255,.08); }

        .btn-sm { padding: 5px 11px; font-size: .78rem; }
        .btn-lg { padding: 12px 24px; font-size: .95rem; }

        /* ── FORM ELEMENTS ── */
        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 22px; }
        .form-grid .full { grid-column: 1 / -1; }

        .form-group { margin-bottom: 18px; }

        .form-label {
            display: block; font-size: .76rem; font-weight: 600;
            letter-spacing: .07em; text-transform: uppercase;
            color: var(--muted); margin-bottom: 7px;
        }

        .form-control, .form-select {
            width: 100%; padding: 11px 14px;
            background: rgba(255,255,255,.05);
            border: 1.5px solid rgba(255,255,255,.1);
            border-radius: 11px; color: var(--white);
            font-family: 'Outfit', sans-serif; font-size: .9rem; outline: none;
            transition: border-color .25s, box-shadow .25s, background .25s;
            appearance: none;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--teal); background: rgba(14,206,206,.05);
            box-shadow: 0 0 0 3px rgba(14,206,206,.12);
        }

        .form-control::placeholder { color: rgba(255,255,255,.2); }

        .form-select option { background: var(--navy-mid); color: var(--white); }

        .has-icon { position: relative; }
        .has-icon .input-icon {
            position: absolute; left: 13px; top: 50%; transform: translateY(-50%);
            color: var(--muted); font-size: .82rem; pointer-events: none; transition: color .2s;
        }

        .has-icon:focus-within .input-icon { color: var(--teal); }
        .has-icon .form-control { padding-left: 38px; }

        textarea.form-control { padding: 12px 14px; resize: vertical; min-height: 90px; }

        .text-danger { font-size: .78rem; color: var(--danger); margin-top: 5px; display: block; }

        .validation-summary-errors {
            background: rgba(242,92,92,.08); border: 1px solid rgba(242,92,92,.28);
            border-radius: 11px; padding: 12px 16px; margin-bottom: 20px;
        }

        .validation-summary-errors ul { list-style: none; }
        .validation-summary-errors ul li { font-size: .84rem; color: var(--danger); padding: 2px 0; }
        .validation-summary-errors ul li::before { content: '⚠  '; }

        /* ── ALERTS ── */
        .alert {
            display: flex; align-items: flex-start; gap: 12px;
            padding: 14px 18px; border-radius: 12px; margin-bottom: 20px;
            font-size: .88rem; line-height: 1.6;
        }

        .alert i { margin-top: 1px; flex-shrink: 0; }

        .alert-success { background: rgba(46,204,113,.08); border: 1px solid rgba(46,204,113,.25); color: var(--success); }
        .alert-danger  { background: rgba(242,92,92,.08);  border: 1px solid rgba(242,92,92,.25);  color: var(--danger); }
        .alert-warning { background: rgba(245,166,35,.08); border: 1px solid rgba(245,166,35,.25); color: var(--warning); }
        .alert-info    { background: rgba(14,206,206,.06); border: 1px solid rgba(14,206,206,.2);  color: var(--teal); }

        /* ── CHECKBOX / MULTI-SELECT ── */
        .check-grid {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
            gap: 8px;
        }

        .check-item {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 14px; border-radius: 10px;
            background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08);
            cursor: pointer; transition: background .2s, border-color .2s;
        }

        .check-item:hover { background: rgba(14,206,206,.07); border-color: rgba(14,206,206,.2); }

        .check-item input[type="checkbox"] {
            appearance: none; width: 17px; height: 17px; border-radius: 5px;
            border: 1.5px solid rgba(255,255,255,.2); background: rgba(255,255,255,.05);
            cursor: pointer; transition: all .2s; flex-shrink: 0; position: relative;
        }

        .check-item input[type="checkbox"]:checked {
            background: var(--teal); border-color: var(--teal);
        }

        .check-item input[type="checkbox"]:checked::after {
            content: '✓'; position: absolute; top: 50%; left: 50%;
            transform: translate(-50%,-50%); color: var(--navy);
            font-size: .65rem; font-weight: 800;
        }

        .check-item label { font-size: .84rem; color: var(--muted); cursor: pointer; flex: 1; }
        .check-item input:checked + label { color: var(--off-white); }

        /* ── EMPTY STATE ── */
        .empty-state {
            text-align: center; padding: 60px 20px;
        }

        .empty-icon {
            width: 70px; height: 70px; border-radius: 50%;
            background: rgba(14,206,206,.07); border: 1px solid rgba(14,206,206,.15);
            display: flex; align-items: center; justify-content: center;
            font-size: 28px; color: var(--teal); margin: 0 auto 20px;
        }

        .empty-state h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 8px; }
        .empty-state p  { font-size: .86rem; color: var(--muted); margin-bottom: 22px; }

        /* ── SECTION TITLE ── */
        .section-title {
            font-size: .69rem; font-weight: 700; letter-spacing: .12em;
            text-transform: uppercase; color: var(--teal);
            display: flex; align-items: center; gap: 8px;
            margin-bottom: 16px;
        }

        .section-title::after {
            content: ''; flex: 1; height: 1px; background: rgba(14,206,206,.2);
        }

        /* ── SEARCH BAR ── */
        .search-bar {
            display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
            margin-bottom: 20px;
        }

        .search-wrap {
            position: relative; flex: 1; min-width: 200px;
        }

        .search-wrap i {
            position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
            color: var(--muted); font-size: .82rem;
        }

        .search-wrap input {
            width: 100%; padding: 9px 12px 9px 36px;
            background: rgba(255,255,255,.05); border: 1.5px solid rgba(255,255,255,.1);
            border-radius: 10px; color: var(--white);
            font-family: 'Outfit', sans-serif; font-size: .88rem; outline: none;
            transition: border-color .25s, box-shadow .25s;
        }

        .search-wrap input:focus {
            border-color: var(--teal); box-shadow: 0 0 0 3px rgba(14,206,206,.1);
        }

        .search-wrap input::placeholder { color: rgba(255,255,255,.2); }

        /* ── MODAL ── */
        .modal-overlay {
            display: none; position: fixed; inset: 0; z-index: 200;
            background: rgba(0,0,0,.6); backdrop-filter: blur(4px);
            align-items: center; justify-content: center; padding: 20px;
        }

        .modal-overlay.open { display: flex; }

        .modal {
            background: var(--navy-mid); border: 1px solid var(--border);
            border-radius: 20px; padding: 32px; width: 100%; max-width: 480px;
            box-shadow: 0 40px 80px rgba(0,0,0,.5);
            animation: modalIn .25s cubic-bezier(.22,1,.36,1);
        }

        @@keyframes modalIn {
            from { opacity: 0; transform: scale(.95) translateY(10px); }
            to   { opacity: 1; transform: scale(1) translateY(0); }
        }

        .modal h3 { font-size: 1.15rem; font-weight: 700; margin-bottom: 8px; }
        .modal p  { font-size: .86rem; color: var(--muted); margin-bottom: 20px; line-height: 1.6; }
        .modal-actions { display: flex; gap: 12px; justify-content: flex-end; flex-wrap: wrap; }

        /* ── RESPONSIVE ── */
        @@media (max-width: 900px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.open { transform: translateX(0); }
            .main-content { margin-left: 0; }
            .topbar { left: 0; }
            .menu-toggle { display: block; }
            .content-area { padding: 24px 18px 48px; }
            .form-grid { grid-template-columns: 1fr; }
            .form-grid .full { grid-column: 1; }
        }

        @@media (max-width: 600px) {
            .stats-grid { grid-template-columns: 1fr 1fr; }
            .page-header { flex-direction: column; }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<!-- ═══ SIDEBAR ═══ -->
<aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
        <div class="brand-icon"><i class="fas fa-flask"></i></div>
        <div class="brand-text">
            <div class="b-name">NMB-HLabSys</div>
            <div class="b-sub">Lab Manager</div>
        </div>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-section-label">Overview</div>
        <a class="@Nav("/LaboratoryManager/Dashboard")" asp-controller="LaboratoryManager" asp-action="Dashboard">
            <i class="fas fa-gauge-high"></i> Dashboard
        </a>

        <div class="nav-section-label">Test Management</div>
        <a class="@Nav("/LaboratoryManager/TestCategories")" asp-controller="LaboratoryManager" asp-action="TestCategories">
            <i class="fas fa-layer-group"></i> Test Categories
        </a>
        <a class="@Nav("/LaboratoryManager/TestTypes")" asp-controller="LaboratoryManager" asp-action="TestTypes">
            <i class="fas fa-vials"></i> Test Types
        </a>

        <div class="nav-section-label">Inventory</div>
        <a class="@Nav("/LaboratoryManager/Consumables")" asp-controller="LaboratoryManager" asp-action="Consumables">
            <i class="fas fa-boxes-stacked"></i> Consumables
        </a>
        <a class="@Nav("/LaboratoryManager/Suppliers")" asp-controller="LaboratoryManager" asp-action="Suppliers">
            <i class="fas fa-truck"></i> Suppliers
        </a>
        <a class="@Nav("/LaboratoryManager/Orders")" asp-controller="LaboratoryManager" asp-action="Orders">
            <i class="fas fa-file-invoice"></i> Orders
        </a>
        <a class="@Nav("/LaboratoryManager/LowStockAlert")" asp-controller="LaboratoryManager" asp-action="LowStockAlert">
            <i class="fas fa-triangle-exclamation"></i> Low Stock Alert
        </a>

        <div class="nav-section-label">Staff</div>
        <a class="@Nav("/LaboratoryManager/Doctors")" asp-controller="LaboratoryManager" asp-action="Doctors">
            <i class="fas fa-user-doctor"></i> Doctors
        </a>
        <a class="@Nav("/LaboratoryManager/Technicians")" asp-controller="LaboratoryManager" asp-action="Technicians">
            <i class="fas fa-microscope"></i> Technicians
        </a>

        <div class="nav-section-label">Reports</div>
        <a class="@Nav("/LaboratoryManager/TestPerformanceReport")" asp-controller="LaboratoryManager" asp-action="TestPerformanceReport">
            <i class="fas fa-chart-bar"></i> Test Performance
        </a>
    </nav>

    <div class="sidebar-footer">
        <div class="user-card">
            <div class="avatar">@initials</div>
            <div class="user-info">
                <div class="u-name">@firstName @lastName</div>
                <div class="u-role">Lab Manager</div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="logout-btn" title="Sign Out">
                    <i class="fas fa-right-from-bracket"></i>
                </button>
            </form>
        </div>
    </div>
</aside>

<!-- ═══ TOPBAR ═══ -->
<header class="topbar">
    <button class="menu-toggle" id="menuToggle" onclick="toggleSidebar()">
        <i class="fas fa-bars"></i>
    </button>

    <div class="topbar-title">
        @if (ViewData["BreadcrumbParent"] != null)
        {
            <span style="color:var(--muted);">@ViewData["BreadcrumbParent"]</span>
            <span style="color:rgba(122,153,187,.4); margin:0 6px;">/</span>
        }
        <span>@ViewData["Title"]</span>
    </div>

    <div class="topbar-actions">
        <a asp-controller="LaboratoryManager" asp-action="LowStockAlert" class="topbar-btn" title="Low Stock Alerts">
            <i class="fas fa-triangle-exclamation"></i>
        </a>
        <a asp-controller="Account" asp-action="ChangePassword" class="topbar-btn" title="Change Password">
            <i class="fas fa-lock"></i>
        </a>
    </div>
</header>

<!-- ═══ MAIN ═══ -->
<main class="main-content">
    <div class="content-area">

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-circle-check"></i>
                <span>@TempData["Message"]</span>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-triangle-exclamation"></i>
                <span>@TempData["Error"]</span>
            </div>
        }

        @RenderBody()
    </div>
</main>

<!-- Overlay for mobile sidebar -->
<div id="sidebarOverlay" onclick="toggleSidebar()"
     style="display:none;position:fixed;inset:0;z-index:99;background:rgba(0,0,0,.5);"></div>

<script>
    function toggleSidebar() {
        const sb = document.getElementById('sidebar');
        const ov = document.getElementById('sidebarOverlay');
        sb.classList.toggle('open');
        ov.style.display = sb.classList.contains('open') ? 'block' : 'none';
    }

    // Auto-dismiss alerts
    document.querySelectorAll('.alert').forEach(a => {
        setTimeout(() => {
            a.style.transition = 'opacity .5s';
            a.style.opacity = '0';
            setTimeout(() => a.remove(), 500);
        }, 4000);
    });

    // Live table search
    function filterTable(inputId, tableId) {
        const q = document.getElementById(inputId).value.toLowerCase();
        document.querySelectorAll(`#${tableId} tbody tr`).forEach(r => {
            r.style.display = r.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    }
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
