@using LaboratoryTestRequestManagementSystem.ViewModel
@model PatientTrackingViewModel
@{
    ViewData["Title"] = "Track Results";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}
<div class="page-header">
    <h1>Track Results Over Time</h1>
</div>

<div class="card">
    <form method="get" asp-action="TrackResults">
        <div style="display: flex; gap: 16px; align-items: flex-end;">
            <div style="flex:1;">
                <label class="form-label">Select Test</label>
                <select name="testTypeId" class="form-select" asp-items="Model.TestTypeOptions">
                    <option value="">-- Choose a test --</option>
                </select>
            </div>
            <div>
                <button type="submit" class="btn btn-primary"><i class="fas fa-chart-line"></i> Show Trend</button>
            </div>
        </div>
    </form>

    @if (Model.SelectedTestTypeId.HasValue && Model.DataPoints != null && Model.DataPoints.Any())
    {
        <div style="margin-top: 32px;">
            <h3 style="margin-bottom: 8px;">@Model.TestName (@Model.Units)</h3>
            <p style="color: var(--muted); margin-bottom: 24px;">Normal range: @(Model.NormalMin) – @(Model.NormalMax)</p>

            <canvas id="trendChart" style="max-height: 300px;"></canvas>
        </div>
    }
    else if (Model.SelectedTestTypeId.HasValue)
    {
        <p style="margin-top: 24px; color: var(--muted);">No results available for this test.</p>
    }
</div>

@section Scripts {
    @if (Model.SelectedTestTypeId.HasValue && Model.DataPoints != null && Model.DataPoints.Any())
    {
        <script>
            // Ensure Chart.js is loaded
            if (typeof Chart === 'undefined') {
                console.error('Chart.js library not loaded.');
            } else {
                const ctx = document.getElementById('trendChart').getContext('2d');
                // Fixed: handle nullable DateTime with null-conditional operator
                const labels = @Html.Raw(Json.Serialize(Model.DataPoints.Select(d => d.Date?.ToString("dd/MM/yyyy") ?? "")));
                const values = @Html.Raw(Json.Serialize(Model.DataPoints.Select(d => d.Value)));
                const normalMin = @Model.NormalMin;
                const normalMax = @Model.NormalMax;

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: '@Model.TestName',
                            data: values,
                            borderColor: '#0ECECE',
                            backgroundColor: 'rgba(14,206,206,0.05)',
                            borderWidth: 3,
                            pointBackgroundColor: values.map(v => (v < normalMin || v > normalMax) ? '#f25c5c' : '#0ECECE'),
                            pointBorderColor: '#0A1628',
                            pointRadius: 6,
                            tension: 0.1
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { labels: { color: '#e8f0f7' } },
                            tooltip: { backgroundColor: '#0F2040', titleColor: '#fff', bodyColor: '#ccc' }
                        },
                        scales: {
                            y: {
                                grid: { color: 'rgba(255,255,255,0.05)' },
                                ticks: { color: '#7a99bb' }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { color: '#7a99bb' }
                            }
                        }
                    }
                });
            }
        </script>
    }
}