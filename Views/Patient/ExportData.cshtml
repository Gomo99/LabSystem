@{
    ViewData["Title"] = "Export My Health Data";
    Layout = "_PatientLayout"; // or dynamic layout selection as in other views
}

<h2>Export Your Health Data</h2>
<p>Download your complete medical record as a JSON file or as a QR code that can be scanned by another lab.</p>

<div class="row mt-4">
    <div class="col-md-6">
        <a asp-action="ExportData" class="btn btn-primary btn-lg w-100">
            <i class="fas fa-download"></i> Download JSON File
        </a>
    </div>
    <div class="col-md-6">
        <a asp-action="ExportQrCode" class="btn btn-secondary btn-lg w-100">
            <i class="fas fa-qrcode"></i> Download QR Code
        </a>
    </div>
</div>