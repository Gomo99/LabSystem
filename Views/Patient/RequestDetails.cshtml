@using LaboratoryTestRequestManagementSystem.AppStatus
@using LaboratoryTestRequestManagementSystem.ViewModel
@model PatientTestRequestDetailsViewModel
@{
    ViewData["Title"] = $"Request #{Model.Id}";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}
<div class="page-header">
    <h1>Request #@Model.Id</h1>
    <div class="actions">
        @if (Model.CanViewResults)
        {
            <a asp-action="DownloadResultsPdf" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="fas fa-download"></i> Download PDF
            </a>
        }
        <a asp-action="TestRequests" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Back</a>
    </div>
</div>

<div class="card mb-4">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div><span style="color: var(--muted);">Doctor:</span> <strong>@Model.DoctorName</strong></div>
        <div><span style="color: var(--muted);">Request Date:</span> @Model.RequestDate.ToString("dd/MM/yyyy HH:mm")</div>
        <div><span style="color: var(--muted);">Urgency:</span> @Model.Urgency</div>
        <div><span style="color: var(--muted);">Status:</span> @Model.Status</div>
    </div>
    @if (!string.IsNullOrEmpty(Model.ClinicalNotes))
    {
        <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,.08);">
            <span style="color: var(--muted);">Clinical Notes:</span>
            <p style="margin-top: 6px;">@Model.ClinicalNotes</p>
        </div>
    }
</div>
@if (Model.Status == RequestStatus.ReleasedByDoctor)
{
    if (!Model.HasGrantedAccess)
    {
        <form asp-action="RequestPdfAccess" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="testRequestId" value="@Model.Id" />
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-file-pdf"></i> Request PDF Access
            </button>
        </form>
    }
    else
    {
        <a asp-action="DownloadResultsPdf" asp-route-id="@Model.Id" class="btn btn-success">
            <i class="fas fa-download"></i> Download PDF
        </a>
    }
}
@if (Model.CanViewResults)
{
    <div class="card">
        <h3 style="margin-bottom: 20px;"><i class="fas fa-flask"></i> Test Results</h3>
        @if (Model.TestResults != null && Model.TestResults.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Test</th>
                            <th>Result</th>
                            <th>Units</th>
                            <th>Normal Range</th>
                            <th>Flag</th>
                            <th>Completed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in Model.TestResults)
                        {
                            <tr>
                                <td>@res.TestName</td>
                                <td>@(res.ResultValue?.ToString() ?? "—")</td>
                                <td>@res.Units</td>
                                <td>@res.NormalRange</td>
                                <td>
                                    @if (res.IsAbnormal)
                                    {
                                        <span class="badge badge-danger">Abnormal</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success">Normal</span>
                                    }
                                </td>
                                <td>@(res.CompletedDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TestResults.Any(r => !string.IsNullOrEmpty(r.Notes)))
            {
                <div style="margin-top: 24px;">
                    <h4>Notes</h4>
                    @foreach (var res in Model.TestResults.Where(r => !string.IsNullOrEmpty(r.Notes)))
                    {
                        <p style="color: var(--muted);">@res.TestName: @res.Notes</p>
                    }
                </div>
            }
        }
        else
        {
            <p style="color: var(--muted);">No results available.</p>
        }
    </div>
}
else
{
    <div class="alert alert-warning" style="background: rgba(245,166,35,.08); border-color: rgba(245,166,35,.3); color: #f5a623;">
        <i class="fas fa-lock"></i> Results are not yet released by the doctor.
    </div>
}