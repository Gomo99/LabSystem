@using LaboratoryTestRequestManagementSystem.ViewModel
@model MedicalConditionViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Create Medical Condition";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Create Medical Condition</h1>
    </div>
    <a asp-action="MedicalConditions" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div class="card" style="max-width:600px;">
    <form asp-action="CreateMedicalCondition" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Category" class="form-label"></label>
            <input asp-for="Category" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Create</button>
    </form>
</div>