@using LaboratoryTestRequestManagementSystem.AppStatus
@using LaboratoryTestRequestManagementSystem.ViewModel
@model AvailableTestTypeViewModel
@{
    Layout = "~/Views/Shared/_TechnicianLayout.cshtml";
    ViewData["Title"] = "Process Tests";
    int currentTechId = (int)ViewBag.CurrentTechnicianId;
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Process Tests</h1>
        <div class="page-sub">Request #@Model.TestRequestId - @Model.PatientName</div>
    </div>
    <a asp-action="AvailableForProcessing" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<!-- Patient Info Card -->
<div class="card">
    <h4 style="margin-bottom:15px;color:var(--teal);"><i class="fas fa-user"></i> Patient Information</h4>
    <p><strong>Clinical Notes:</strong> @(Model.ClinicalNotes ?? "None")</p>
    <div class="row">
        <div class="col-md-4">
            <strong>Medical Conditions:</strong>
            <ul style="margin-top:5px;">
                @foreach (var cond in Model.MedicalConditions)
                {
                    <li>@cond</li>
                }
            </ul>
        </div>
        <div class="col-md-4">
            <strong>Allergies:</strong>
            <ul style="margin-top:5px;">
                @foreach (var allergy in Model.Allergies)
                {
                    <li>@allergy</li>
                }
            </ul>
        </div>
        <div class="col-md-4">
            <strong>Medications:</strong>
            <ul style="margin-top:5px;">
                @foreach (var med in Model.Medications)
                {
                    <li>@med</li>
                }
            </ul>
        </div>
    </div>
</div>

<!-- Test Types Table -->
<div class="card">
    @if (!Model.TestTypes.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> You are not qualified for any test types on this request.
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Test</th>
                        <th>Sample</th>
                        <th>Status</th>
                        <th>Assigned To</th>
                        <th>Started</th>
                        <th>Expected</th>
                        <th>Remaining</th> <!-- NEW -->
                        <th>Completed</th>
                        <th>Verified By</th>
                        <th>Notes</th> <!-- NEW -->
                        <th style="width:220px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var test in Model.TestTypes)
                    {
                        <tr class="@(test.IsOverdue ? "table-danger" : "")">
                            <td>@test.TestName</td>
                            <td>@test.SampleType</td>
                            <td>@test.Status</td>
                            <td>@(test.TechnicianName ?? "—")</td>
                            <td>@(test.StartDateTime?.ToString("dd/MM HH:mm") ?? "—")</td>
                            <td>@(test.ExpectedCompletionTime?.ToString("dd/MM HH:mm") ?? "—")</td>
                            <td>
                                @test.RemainingTimeDisplay
                                @if (test.IsPaused)
                                {
                                    <span class="badge badge-warn">PAUSED</span>
                                }
                            </td>
                            <td>@(test.CompletionDateTime?.ToString("dd/MM HH:mm") ?? "—")</td>
                            <td>@(test.VerifiedByName ?? "—")</td>
                            <td>
                                @if (test.CanComplete || test.CanPause || test.CanResume)
                                {
                                    <input type="text" class="form-control form-control-sm technician-notes"
                                           data-testrequestid="@test.TestRequestId" data-testtypeid="@test.TestTypeId"
                                           value="@test.TechnicianNotes" placeholder="Add note..."
                                           style="width:120px; display:inline-block;" />
                                    <button class="btn btn-ghost btn-sm save-notes-btn"
                                            data-testrequestid="@test.TestRequestId" data-testtypeid="@test.TestTypeId">
                                        <i class="fas fa-save"></i>
                                    </button>
                                }
                                else
                                {
                                    @test.TechnicianNotes
                                }
                            </td>
                            <td>
                                <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                    @if (test.Status == RequestStatus.Submitted && test.TechnicianId == null)
                                    {
                                        <form asp-action="StartTest" method="post">
                                            <input type="hidden" name="testRequestId" value="@test.TestRequestId" />
                                            <input type="hidden" name="testTypeId" value="@test.TestTypeId" />
                                            <button type="submit" class="btn btn-success btn-sm">Start</button>
                                        </form>
                                    }
                                    @if (test.CanPause)
                                    {
                                        <form asp-action="PauseTest" method="post" style="display:inline;">
                                            <input type="hidden" name="testRequestId" value="@test.TestRequestId" />
                                            <input type="hidden" name="testTypeId" value="@test.TestTypeId" />
                                            <button type="submit" class="btn btn-warning btn-sm">Pause</button>
                                        </form>
                                    }
                                    @if (test.CanResume)
                                    {
                                        <form asp-action="ResumeTest" method="post" style="display:inline;">
                                            <input type="hidden" name="testRequestId" value="@test.TestRequestId" />
                                            <input type="hidden" name="testTypeId" value="@test.TestTypeId" />
                                            <button type="submit" class="btn btn-info btn-sm">Resume</button>
                                        </form>
                                    }
                                    @if (test.CanComplete)
                                    {
                                        <a asp-action="CaptureResult" asp-route-testRequestId="@test.TestRequestId" asp-route-testTypeId="@test.TestTypeId" class="btn btn-primary btn-sm">Capture Results</a>
                                    }
                                    else if (test.CanVerify)
                                    {
                                        <button type="button" class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#verifyModal-@test.TestTypeId">Verify</button>
                                        <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#returnModal-@test.TestTypeId">Return</button>
                                    }
                                    else if (test.CanResubmit)
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#resubmitModal-@test.TestTypeId">Resubmit</button>
                                    }
                                    else if (test.Status == RequestStatus.Verified)
                                    {
                                        <span class="badge badge-green">Verified</span>
                                    }
                                    else if (test.Status == RequestStatus.ToBeReviewed)
                                    {
                                        <span class="badge badge-danger">Awaiting Review</span>
                                    }

                                    <!-- History Button -->
                                    <button type="button" class="btn btn-ghost btn-sm" data-bs-toggle="modal" data-bs-target="#historyModal-@test.TestTypeId">
                                        <i class="fas fa-history"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>




<!-- Modals for each test -->
@foreach (var test in Model.TestTypes)
{
    <!-- Verify Modal -->
    <!-- Inside the loop for each test in ProcessTestTypes.cshtml -->
    <div class="modal fade" id="verifyModal-@test.TestTypeId" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" style="background:var(--navy-mid);border:1px solid var(--border);border-radius:20px;">
                <form asp-action="VerifyTest" method="post" id="verifyForm-@test.TestTypeId">
                    <input type="hidden" name="testRequestId" value="@test.TestRequestId" />
                    <input type="hidden" name="testTypeId" value="@test.TestTypeId" />
                    <div class="modal-header">
                        <h5 class="modal-title" style="color:var(--white);">Verify: @test.TestName</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <!-- Verification Checklist -->
                        <h6 style="color:var(--white); margin-bottom:10px;">Verification Checklist</h6>
                        <div class="form-check">
                            <input class="form-check-input checklist-item" type="checkbox" name="selectedChecklistItems" value="Result within normal range" id="check1-@test.TestTypeId" />
                            <label class="form-check-label" for="check1-@test.TestTypeId">Result within normal range</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input checklist-item" type="checkbox" name="selectedChecklistItems" value="No critical flags" id="check2-@test.TestTypeId" />
                            <label class="form-check-label" for="check2-@test.TestTypeId">No critical flags</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input checklist-item" type="checkbox" name="selectedChecklistItems" value="Sample quality acceptable" id="check3-@test.TestTypeId" />
                            <label class="form-check-label" for="check3-@test.TestTypeId">Sample quality acceptable</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input checklist-item" type="checkbox" name="selectedChecklistItems" value="Test method followed" id="check4-@test.TestTypeId" />
                            <label class="form-check-label" for="check4-@test.TestTypeId">Test method followed</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input checklist-item" type="checkbox" name="selectedChecklistItems" value="Documentation complete" id="check5-@test.TestTypeId" />
                            <label class="form-check-label" for="check5-@test.TestTypeId">Documentation complete</label>
                        </div>

                        <hr style="border-color:var(--border);" />

                        <!-- Verification Notes -->
                        <div class="form-group">
                            <label class="form-label" style="color:var(--white);">Verification Notes</label>
                            <textarea name="verificationNotes" class="form-control" rows="3" placeholder="Optional notes"></textarea>
                        </div>

                        <!-- Digital Signature -->
                        <div class="form-check mt-3">
                            <input class="form-check-input" type="checkbox" name="digitalSignature" value="true" id="sign-@test.TestTypeId" />
                            <label class="form-check-label" for="sign-@test.TestTypeId" style="color:var(--white);">
                                I, <strong>@User.Identity?.Name</strong>, certify that I have reviewed the results and verified the test.
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-ghost btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-info btn-sm" id="submitVerify-@test.TestTypeId" disabled>Verify</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Return Modal -->
    <div class="modal fade" id="returnModal-@test.TestTypeId" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" style="background:var(--navy-mid);border:1px solid var(--border);border-radius:20px;">
                <form asp-action="ReturnForReview" method="post">
                    <input type="hidden" name="testRequestId" value="@test.TestRequestId" />
                    <input type="hidden" name="testTypeId" value="@test.TestTypeId" />
                    <div class="modal-header">
                        <h5 class="modal-title" style="color:var(--white);">Return for Review: @test.TestName</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <textarea name="reviewNotes" class="form-control" rows="3" placeholder="Reason for return" required></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-ghost btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning btn-sm">Return</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Resubmit Modal -->
    <div class="modal fade" id="resubmitModal-@test.TestTypeId" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" style="background:var(--navy-mid);border:1px solid var(--border);border-radius:20px;">
                <form asp-action="ResubmitForVerification" method="post">
                    <input type="hidden" name="testRequestId" value="@test.TestRequestId" />
                    <input type="hidden" name="testTypeId" value="@test.TestTypeId" />
                    <div class="modal-header">
                        <h5 class="modal-title" style="color:var(--white);">Resubmit: @test.TestName</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label class="form-label">Adjusted Result Value</label>
                            <input type="text" name="adjustedResultValue" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Notes</label>
                            <textarea name="resubmitNotes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-ghost btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary btn-sm">Resubmit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- History Modal -->
    <div class="modal fade" id="historyModal-@test.TestTypeId" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" style="background:var(--navy-mid);border:1px solid var(--border);border-radius:20px;">
                <div class="modal-header">
                    <h5 class="modal-title" style="color:var(--white);">Review History: @test.TestName</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @await Component.InvokeAsync("TestReviewHistory", new { testRequestId = test.TestRequestId, testTypeId = test.TestTypeId })
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

         $(function () {
            // For each verify modal, monitor checkboxes
            $('[id^=verifyModal-]').each(function () {
                var modalId = $(this).attr('id');
                var testTypeId = modalId.split('-')[1]; // extract testTypeId
                var form = $('#verifyForm-' + testTypeId);
                var submitBtn = $('#submitVerify-' + testTypeId);
                var checkboxes = form.find('.checklist-item');
                var signatureCheck = $('#sign-' + testTypeId);

                function updateSubmit() {
                    var allChecklistChecked = checkboxes.length > 0 && checkboxes.filter(':checked').length > 0;
                    var isSigned = signatureCheck.is(':checked');
                    submitBtn.prop('disabled', !(allChecklistChecked && isSigned));
                }

                checkboxes.on('change', updateSubmit);
                signatureCheck.on('change', updateSubmit);
            });
        });
}