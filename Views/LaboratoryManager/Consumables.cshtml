@model IEnumerable<Consumable>
@{
    Layout = "~/Views/Shared/_LabManagerLayout.cshtml";
    ViewData["Title"] = "Consumables";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Consumables</h1>
        <div class="page-sub">Manage stock items</div>
    </div>
    <div style="display:flex;gap:10px;">
        <a asp-action="InactiveConsumables" class="btn btn-ghost btn-sm">
            <i class="fas fa-archive"></i> View Inactive
        </a>
        <a asp-action="CreateConsumable" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i> New Consumable
        </a>
    </div>
</div>

<div class="card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="fas fa-boxes-stacked"></i></div>
            <h3>No consumables</h3>
            <p>Add a consumable to track inventory.</p>
            <a asp-action="CreateConsumable" class="btn btn-primary">Add Consumable</a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Supplier</th>
                        <th>Qty on Hand</th>
                        <th>Reorder Level</th>
                        <th>Status</th>
                        <th style="width:220px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var lowStock = item.QuantityOnHand <= item.ReorderLevel;
                        <tr>
                            <td>@item.ConsumableName</td>
                            <td>@item.Supplier?.SupplierName</td>
                            <td>
                                <span style="@(lowStock ? "color:var(--warning);font-weight:600;" : "")">
                                    @item.QuantityOnHand
                                </span>
                            </td>
                            <td>@item.ReorderLevel</td>
                            <td>
                                @if (lowStock)
                                {
                                    <span class="badge badge-warn">Low Stock</span>
                                }
                                else
                                {
                                    <span class="badge badge-green">OK</span>
                                }
                            </td>
                            <td>
                                <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                    <a asp-action="EditConsumable" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <button type="button" class="btn btn-ghost btn-sm" onclick="openAdjustModal(@item.Id, '@item.ConsumableName', @item.QuantityOnHand)">
                                        <i class="fas fa-sliders"></i>
                                    </button>
                                    <form asp-action="DeleteConsumable" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Deactivate this consumable?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Adjust Stock Modal -->
<div class="modal fade" id="adjustStockModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background:var(--navy-mid);border:1px solid var(--border);border-radius:20px;">
            <form asp-action="AdjustStock" method="post">
                <input type="hidden" name="ConsumableId" id="adjustConsumableId" />
                <div class="modal-header" style="border-bottom:1px solid var(--border-soft);padding:20px;">
                    <h5 class="modal-title" style="color:var(--white);">Adjust Stock: <span id="adjustConsumableName"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" style="filter:invert(1);"></button>
                </div>
                <div class="modal-body" style="padding:20px;">
                    <p>Current quantity: <strong id="adjustCurrentQty"></strong></p>
                    <div class="form-group">
                        <label class="form-label">Adjustment Type</label>
                        <select name="AdjustmentType" class="form-select" required>
                            <option value="Increase">Increase</option>
                            <option value="Decrease">Decrease</option>
                            <option value="Set">Set to exact value</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Quantity</label>
                        <input type="number" name="Quantity" class="form-control" min="0" required />
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid var(--border-soft);padding:20px;">
                    <button type="button" class="btn btn-ghost btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Apply</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function openAdjustModal(id, name, qty) {
            document.getElementById('adjustConsumableId').value = id;
            document.getElementById('adjustConsumableName').textContent = name;
            document.getElementById('adjustCurrentQty').textContent = qty;
            new bootstrap.Modal(document.getElementById('adjustStockModal')).show();
        }
    </script>
}