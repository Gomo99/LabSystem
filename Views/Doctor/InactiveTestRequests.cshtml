@using LaboratoryTestRequestManagementSystem.AppStatus
@using LaboratoryTestRequestManagementSystem.ViewModel
@model IEnumerable<TestRequestListViewModel>
@{
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    ViewData["Title"] = "Archived Test Requests";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Archived Test Requests</h1>
        <div class="page-sub">Soft-deleted requests</div>
    </div>
    <a asp-action="TestRequests" class="btn btn-ghost btn-sm">
        <i class="fas fa-arrow-left"></i> Back to Active
    </a>
</div>

<div class="card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="fas fa-archive"></i></div>
            <h3>No archived requests</h3>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Patient</th>
                        <th>Request Date</th>
                        <th>Urgency</th>
                        <th>Status</th>
                        <th>Tests</th>
                        <th style="width:100px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Model)
                    {
                        <tr>
                            <td>#@req.Id</td>
                            <td>@req.PatientName</td>
                            <td>@req.RequestDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (req.Urgency == Urgency.Stat)
                                {
                                    <span class="badge badge-danger">STAT</span>
                                }
                                else if (req.Urgency == Urgency.Urgent)
                                {
                                    <span class="badge badge-warn">Urgent</span>
                                }
                                else
                                {
                                    <span class="badge badge-muted">Routine</span>
                                }
                            </td>
                            <td>@req.Status</td>
                            <td>@req.TestCount</td>
                            <td>
                                <form asp-action="RestoreRequest" method="post">
                                    <input type="hidden" name="id" value="@req.Id" />
                                    <button type="submit" class="btn btn-warning btn-sm">
                                        <i class="fas fa-rotate-left"></i> Restore
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>