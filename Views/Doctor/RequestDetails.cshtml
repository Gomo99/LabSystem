@using LaboratoryTestRequestManagementSystem.AppStatus
@using LaboratoryTestRequestManagementSystem.ViewModel
@model TestRequestDetailsViewModel
@{
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    ViewData["Title"] = "Test Request Details";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Request #@Model.Id</h1>
        <div class="page-sub">@Model.PatientName | @Model.RequestDate.ToString("dd/MM/yyyy")</div>
    </div>
    <div style="display:flex;gap:10px;">
        @if (Model.Status == RequestStatus.Completed)
        {
            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#releaseModal">
                <i class="fas fa-check-circle"></i> Release Results
            </button>
        }
        @if (Model.Status == RequestStatus.Completed || Model.Status == RequestStatus.ReleasedByDoctor)
        {
            <a asp-action="DownloadResultsPdf" asp-route-id="@Model.Id" class="btn btn-secondary btn-sm">
                <i class="fas fa-download"></i> Download PDF
            </a>
        }
        @if (Model.Status == RequestStatus.Submitted || Model.Status == RequestStatus.SamplesReceived)
        {
            <a asp-action="EditRequest" asp-route-id="@Model.Id" class="btn btn-secondary btn-sm">
                <i class="fas fa-pen"></i> Edit
            </a>
            <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#cancelModal">
                <i class="fas fa-ban"></i> Cancel
            </button>
        }
        <a asp-action="TestRequests" class="btn btn-ghost btn-sm">
            <i class="fas fa-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="card">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px;">
        <div>
            <h3 style="font-size:.9rem;color:var(--teal);margin-bottom:12px;">Request Information</h3>
            <dl style="display:grid;gap:8px;">
                <div><dt style="color:var(--muted);font-size:.8rem;">Doctor</dt><dd>@Model.DoctorName</dd></div>
                <div><dt style="color:var(--muted);font-size:.8rem;">Urgency</dt><dd>@Model.Urgency</dd></div>
                <div><dt style="color:var(--muted);font-size:.8rem;">Status</dt><dd><span class="badge badge-teal">@Model.Status</span></dd></div>
                <div><dt style="color:var(--muted);font-size:.8rem;">Clinical Notes</dt><dd>@(Model.ClinicalNotes ?? "None")</dd></div>
            </dl>
        </div>
        <div>
            <h3 style="font-size:.9rem;color:var(--teal);margin-bottom:12px;">Samples Collected</h3>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Barcode</th><th>Sample Type</th><th>Collected</th></tr></thead>
                    <tbody>
                        @foreach (var sample in Model.Samples)
                        {
                            <tr>
                                <td>@sample.Barcode</td>
                                <td>@sample.SampleType</td>
                                <td>@(sample.CollectedDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.Status == RequestStatus.Cancelled)
    {
        <div class="alert alert-warning" style="margin-bottom:20px;">
            <i class="fas fa-ban"></i>
            <span>Request cancelled on @Model.DateCancelled?.ToString("dd/MM/yyyy") - Reason: @Model.CancellationReason</span>
        </div>
    }

    <h3 style="font-size:.9rem;color:var(--teal);margin-bottom:12px;">Test Results</h3>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Test</th>
                    <th>Sample Type</th>
                    <th>Status</th>
                    <th>Result</th>
                    <th>Normal Range</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var test in Model.TestTypes)
                {
                    <tr class="@(test.IsAbnormal ? "table-danger" : "")">
                        <td>@test.TestName</td>
                        <td>@test.SampleType</td>
                        <td>@test.Status</td>
                        <td>@(test.ResultValue ?? "—")</td>
                        <td>@(test.NormalRange ?? "—")</td>
                        <td>@(test.Notes ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Release Modal -->
@if (Model.Status == RequestStatus.Completed)
{
    <div class="modal fade" id="releaseModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" style="background:var(--navy-mid);border:1px solid var(--border);border-radius:20px;">
                <form asp-action="ReleaseResults" method="post">
                    <input type="hidden" name="RequestId" value="@Model.Id" />
                    <div class="modal-header" style="border-bottom:1px solid var(--border-soft);padding:20px;">
                        <h5 class="modal-title" style="color:var(--white);">Release Results</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" style="filter:invert(1);"></button>
                    </div>
                    <div class="modal-body" style="padding:20px;">
                        <div class="form-group">
                            <label class="form-label">Note to patient</label>
                            <textarea name="Note" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="form-check mt-2">
                            <input type="checkbox" name="AttachPdf" value="true" class="form-check-input" checked />
                            <label class="form-check-label" style="color:var(--muted);">Attach PDF of results</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" name="RequestAppointment" value="true" class="form-check-input" />
                            <label class="form-check-label" style="color:var(--muted);">Ask patient to schedule appointment</label>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top:1px solid var(--border-soft);padding:20px;">
                        <button type="button" class="btn btn-ghost btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success btn-sm">Release</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Cancel Modal -->
@if (Model.Status == RequestStatus.Submitted || Model.Status == RequestStatus.SamplesReceived)
{
    <div class="modal fade" id="cancelModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" style="background:var(--navy-mid);border:1px solid var(--border);border-radius:20px;">
                <form asp-action="CancelRequest" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="modal-header" style="border-bottom:1px solid var(--border-soft);padding:20px;">
                        <h5 class="modal-title" style="color:var(--white);">Cancel Test Request</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" style="filter:invert(1);"></button>
                    </div>
                    <div class="modal-body" style="padding:20px;">
                        <div class="form-group">
                            <label class="form-label">Reason for cancellation</label>
                            <textarea name="cancellationReason" class="form-control" rows="3" required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top:1px solid var(--border-soft);padding:20px;">
                        <button type="button" class="btn btn-ghost btn-sm" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-danger btn-sm">Confirm Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}