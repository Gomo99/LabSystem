@model LaboratoryTestRequestManagementSystem.ViewModel.PatientRegistrationViewModel
@{
    Layout = null;
    ViewData["Title"] = "Patient Registration – NMB-HLabSys";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --navy:       #0A1628;
            --navy-mid:   #0F2040;
            --teal:       #0ECECE;
            --teal-dark:  #09a8a8;
            --teal-glow:  rgba(14,206,206,.18);
            --white:      #FFFFFF;
            --off-white:  #e8f0f7;
            --muted:      #7a99bb;
            --danger:     #f25c5c;
            --card-bg:    rgba(15,32,64,.72);
            --border:     rgba(14,206,206,.22);
        }

        html, body {
            min-height: 100%;
            font-family: 'Outfit', sans-serif;
            background: var(--navy);
            color: var(--white);
        }

        .bg-scene {
            position: fixed; inset: 0; z-index: 0;
            background: linear-gradient(135deg, #060e1c 0%, #0A1628 45%, #0d2040 100%);
        }

        .bg-scene::before {
            content: '';
            position: absolute;
            width: 600px; height: 600px;
            top: -100px; right: -100px;
            background: radial-gradient(circle, rgba(14,206,206,.10) 0%, transparent 70%);
            animation: pulseOrb 9s ease-in-out infinite alternate;
        }

        .bg-scene::after {
            content: '';
            position: absolute;
            width: 400px; height: 400px;
            bottom: -100px; left: 0;
            background: radial-gradient(circle, rgba(14,206,206,.07) 0%, transparent 70%);
            animation: pulseOrb 11s ease-in-out infinite alternate-reverse;
        }

        @@keyframes pulseOrb {
            from { transform: scale(1); }
            to   { transform: scale(1.25); }
        }

        .grid-overlay {
            position: fixed; inset: 0; z-index: 0;
            background-image:
                linear-gradient(rgba(14,206,206,.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(14,206,206,.04) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        /* ── PAGE ── */
        .page-wrapper {
            position: relative; z-index: 1;
            min-height: 100vh;
            display: flex; align-items: flex-start; justify-content: center;
            padding: 50px 20px 60px;
        }

        .card {
            width: 100%; max-width: 700px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 24px;
            padding: 48px 48px 44px;
            backdrop-filter: blur(24px);
            box-shadow: 0 40px 80px rgba(0,0,0,.4), 0 0 0 1px rgba(255,255,255,.04);
            animation: fadeUp .65s cubic-bezier(.22,1,.36,1) both;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(30px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ── HEADER ── */
        .card-header {
            display: flex; align-items: center; gap: 18px;
            margin-bottom: 36px; padding-bottom: 28px;
            border-bottom: 1px solid rgba(255,255,255,.07);
        }

        .header-icon {
            width: 54px; height: 54px; border-radius: 15px; flex-shrink: 0;
            background: linear-gradient(135deg, var(--teal), var(--teal-dark));
            display: flex; align-items: center; justify-content: center;
            font-size: 22px; color: var(--navy);
            box-shadow: 0 0 24px var(--teal-glow);
        }

        .header-text h2 {
            font-size: 1.55rem; font-weight: 700; margin-bottom: 4px;
        }

        .header-text p {
            font-size: .85rem; color: var(--muted);
        }

        /* ── PROGRESS STEPS ── */
        .step-bar {
            display: flex; align-items: center;
            margin-bottom: 36px; gap: 0;
        }

        .step {
            display: flex; align-items: center; flex: 1;
        }

        .step-bubble {
            width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            font-size: .78rem; font-weight: 700;
            background: rgba(255,255,255,.07);
            border: 1.5px solid rgba(255,255,255,.12);
            color: var(--muted);
            transition: all .3s;
        }

        .step.active .step-bubble {
            background: var(--teal); border-color: var(--teal);
            color: var(--navy);
            box-shadow: 0 0 14px var(--teal-glow);
        }

        .step.done .step-bubble {
            background: rgba(14,206,206,.15);
            border-color: var(--teal); color: var(--teal);
        }

        .step-label {
            font-size: .72rem; color: var(--muted); margin-left: 8px;
            white-space: nowrap;
        }

        .step.active .step-label { color: var(--off-white); font-weight: 600; }

        .step-line {
            flex: 1; height: 1px;
            background: rgba(255,255,255,.1);
            margin: 0 10px;
        }

        /* ── SECTION LABEL ── */
        .section-title {
            font-size: .7rem; font-weight: 700;
            letter-spacing: .12em; text-transform: uppercase;
            color: var(--teal); margin-bottom: 18px;
            display: flex; align-items: center; gap: 8px;
        }

        .section-title::after {
            content: ''; flex: 1;
            height: 1px; background: rgba(14,206,206,.2);
        }

        /* ── GRID ── */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px 20px;
            margin-bottom: 28px;
        }

        .form-grid .full { grid-column: 1 / -1; }

        /* ── FORM ELEMENTS ── */
        .form-group { position: relative; }

        .form-label {
            display: block; font-size: .77rem; font-weight: 600;
            letter-spacing: .07em; text-transform: uppercase;
            color: var(--muted); margin-bottom: 7px;
        }

        .input-wrap { position: relative; }

        .input-wrap .input-icon {
            position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
            color: var(--muted); font-size: .82rem; pointer-events: none;
            transition: color .2s;
        }

        .input-wrap:focus-within .input-icon { color: var(--teal); }

        .toggle-pw {
            position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
            background: none; border: none; color: var(--muted);
            cursor: pointer; font-size: .82rem; padding: 4px;
            transition: color .2s;
        }

        .toggle-pw:hover { color: var(--teal); }

        .form-control {
            width: 100%;
            padding: 12px 14px 12px 40px;
            background: rgba(255,255,255,.05);
            border: 1.5px solid rgba(255,255,255,.1);
            border-radius: 11px;
            color: var(--white);
            font-family: 'Outfit', sans-serif; font-size: .92rem;
            outline: none;
            transition: border-color .25s, box-shadow .25s, background .25s;
        }

        .form-control:focus {
            border-color: var(--teal);
            background: rgba(14,206,206,.05);
            box-shadow: 0 0 0 4px rgba(14,206,206,.12);
        }

        .form-control::placeholder { color: rgba(255,255,255,.22); }

        .form-control.has-pw { padding-right: 44px; }

        .text-danger { font-size: .76rem; color: var(--danger); margin-top: 5px; display: block; }

        /* Password strength bar */
        .pw-strength {
            margin-top: 8px;
            display: flex; gap: 5px; align-items: center;
        }

        .pw-strength .bar {
            flex: 1; height: 3px; border-radius: 3px;
            background: rgba(255,255,255,.08);
            transition: background .3s;
        }

        .pw-strength .bar.weak   { background: #f25c5c; }
        .pw-strength .bar.medium { background: #f5a623; }
        .pw-strength .bar.strong { background: var(--teal); }

        .pw-strength .pw-text {
            font-size: .72rem; color: var(--muted);
            min-width: 50px; text-align: right;
        }

        /* Validation summary */
        .validation-summary-errors {
            background: rgba(242,92,92,.08);
            border: 1px solid rgba(242,92,92,.3);
            border-radius: 10px; padding: 12px 16px; margin-bottom: 24px;
        }

        .validation-summary-errors ul { list-style: none; }

        .validation-summary-errors ul li {
            font-size: .84rem; color: var(--danger);
            padding: 2px 0;
        }

        .validation-summary-errors ul li::before { content: '⚠  '; }

        /* ── BUTTONS ── */
        .btn-row {
            display: flex; align-items: center;
            justify-content: space-between; margin-top: 32px; gap: 14px;
        }

        .btn-primary {
            flex: 1; padding: 14px;
            border: none; border-radius: 12px;
            background: linear-gradient(135deg, var(--teal), var(--teal-dark));
            color: var(--navy); font-family: 'Outfit', sans-serif;
            font-size: .98rem; font-weight: 700; cursor: pointer;
            transition: transform .15s, box-shadow .25s, filter .2s;
            box-shadow: 0 4px 24px rgba(14,206,206,.35);
        }

        .btn-primary:hover {
            transform: translateY(-2px); filter: brightness(1.06);
            box-shadow: 0 8px 32px rgba(14,206,206,.5);
        }

        .btn-primary:active { transform: none; }

        .back-link {
            font-size: .88rem; color: var(--muted);
            text-decoration: none; display: flex; align-items: center; gap: 7px;
            transition: color .2s;
        }

        .back-link:hover { color: var(--teal); }

        /* ── FOOTER NOTE ── */
        .card-footer-note {
            margin-top: 24px; padding-top: 20px;
            border-top: 1px solid rgba(255,255,255,.06);
            text-align: center;
            font-size: .84rem; color: var(--muted);
        }

        .card-footer-note a { color: var(--teal); text-decoration: none; font-weight: 600; }
        .card-footer-note a:hover { opacity: .75; }

        /* ── RESPONSIVE ── */
        @@media (max-width: 600px) {
            .card { padding: 32px 22px; }
            .form-grid { grid-template-columns: 1fr; }
            .form-grid .full { grid-column: 1; }
        }
    </style>
</head>
<body>
    <div class="bg-scene"></div>
    <div class="grid-overlay"></div>

    <div class="page-wrapper">
        <div class="card">

            <!-- Header -->
            <div class="card-header">
                <div class="header-icon"><i class="fas fa-user-plus"></i></div>
                <div class="header-text">
                    <h2>Patient Registration</h2>
                    <p>Create your NMB-HLabSys patient account</p>
                </div>
            </div>

            <!-- Step bar (decorative) -->
            <div class="step-bar">
                <div class="step active">
                    <div class="step-bubble">1</div>
                    <span class="step-label">Personal Info</span>
                </div>
                <div class="step-line"></div>
                <div class="step">
                    <div class="step-bubble">2</div>
                    <span class="step-label">Security</span>
                </div>
                <div class="step-line"></div>
                <div class="step">
                    <div class="step-bubble">3</div>
                    <span class="step-label">Complete</span>
                </div>
            </div>

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" id="valSummary"></div>

            <form asp-action="RegisterPatient" asp-controller="Account" method="post" id="regForm">
                @Html.AntiForgeryToken()

                <!-- PERSONAL DETAILS -->
                <div class="section-title"><i class="fas fa-id-card"></i> Personal Details</div>

                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="FirstName" class="form-label">First Name</label>
                        <div class="input-wrap">
                            <i class="fas fa-user input-icon"></i>
                            <input asp-for="FirstName" class="form-control" placeholder="John" />
                        </div>
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="LastName" class="form-label">Last Name</label>
                        <div class="input-wrap">
                            <i class="fas fa-user input-icon"></i>
                            <input asp-for="LastName" class="form-control" placeholder="Smith" />
                        </div>
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="SouthAfricanIdNumber" class="form-label">SA ID Number</label>
                        <div class="input-wrap">
                            <i class="fas fa-address-card input-icon"></i>
                            <input asp-for="SouthAfricanIdNumber" class="form-control"
                                   placeholder="0001010000000" maxlength="13" />
                        </div>
                        <span asp-validation-for="SouthAfricanIdNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                        <div class="input-wrap">
                            <i class="fas fa-calendar input-icon"></i>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                        </div>
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CellphoneNumber" class="form-label">Cellphone Number</label>
                        <div class="input-wrap">
                            <i class="fas fa-phone input-icon"></i>
                            <input asp-for="CellphoneNumber" class="form-control"
                                   placeholder="0821234567" />
                        </div>
                        <span asp-validation-for="CellphoneNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email" class="form-label">E-mail Address</label>
                        <div class="input-wrap">
                            <i class="fas fa-envelope input-icon"></i>
                            <input asp-for="Email" type="email" class="form-control"
                                   placeholder="you@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group full">
                        <label asp-for="HomeAddress" class="form-label">Home Address</label>
                        <div class="input-wrap">
                            <i class="fas fa-location-dot input-icon"></i>
                            <input asp-for="HomeAddress" class="form-control"
                                   placeholder="12 Main Street, Port Elizabeth, 6001" />
                        </div>
                        <span asp-validation-for="HomeAddress" class="text-danger"></span>
                    </div>
                </div>

                <!-- SECURITY -->
                <div class="section-title"><i class="fas fa-lock"></i> Security</div>

                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="input-wrap">
                            <i class="fas fa-lock input-icon"></i>
                            <input asp-for="Password" type="password" id="regPw"
                                   class="form-control has-pw"
                                   placeholder="••••••••"
                                   oninput="checkStrength(this.value)"
                                   autocomplete="new-password" />
                            <button type="button" class="toggle-pw" onclick="togglePw('regPw','pwIcon1')">
                                <i class="fas fa-eye" id="pwIcon1"></i>
                            </button>
                        </div>
                        <div class="pw-strength" id="pwStrength">
                            <div class="bar" id="bar1"></div>
                            <div class="bar" id="bar2"></div>
                            <div class="bar" id="bar3"></div>
                            <span class="pw-text" id="pwText">—</span>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <div class="input-wrap">
                            <i class="fas fa-lock input-icon"></i>
                            <input asp-for="ConfirmPassword" type="password" id="regPwConfirm"
                                   class="form-control has-pw"
                                   placeholder="••••••••"
                                   autocomplete="new-password" />
                            <button type="button" class="toggle-pw" onclick="togglePw('regPwConfirm','pwIcon2')">
                                <i class="fas fa-eye" id="pwIcon2"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <!-- Requirement hint -->
                <div style="background:rgba(14,206,206,.06);border:1px solid rgba(14,206,206,.15);border-radius:10px;padding:12px 16px;margin-bottom:10px;font-size:.82rem;color:var(--muted);line-height:1.7;">
                    <i class="fas fa-circle-info" style="color:var(--teal);margin-right:6px;"></i>
                    Password must be at least <strong style="color:var(--off-white);">8 characters</strong> and contain an
                    <strong style="color:var(--off-white);">uppercase letter</strong>,
                    a <strong style="color:var(--off-white);">number</strong>, and a
                    <strong style="color:var(--off-white);">special character</strong>.
                </div>

                <!-- Buttons -->
                <div class="btn-row">
                    <a asp-action="Login" asp-controller="Account" class="back-link">
                        <i class="fas fa-arrow-left"></i> Back to login
                    </a>
                    <button type="submit" class="btn-primary">
                        <i class="fas fa-user-check" style="margin-right:8px;"></i>Create Account
                    </button>
                </div>
            </form>

            <div class="card-footer-note">
                Already have an account? <a asp-action="Login" asp-controller="Account">Sign in here</a>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const vs = document.querySelector('#valSummary ul');
            if (!vs || vs.children.length === 0)
                document.getElementById('valSummary').style.display = 'none';
        });

        function togglePw(inputId, iconId) {
            const inp = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            inp.type = inp.type === 'password' ? 'text' : 'password';
            icon.className = inp.type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
        }

        function checkStrength(pw) {
            const bars = [document.getElementById('bar1'), document.getElementById('bar2'), document.getElementById('bar3')];
            const label = document.getElementById('pwText');
            bars.forEach(b => b.className = 'bar');

            let score = 0;
            if (pw.length >= 8)                     score++;
            if (/[A-Z]/.test(pw) && /\d/.test(pw)) score++;
            if (/[^a-zA-Z0-9\s]/.test(pw))         score++;

            const classes = ['weak', 'medium', 'strong'];
            const labels  = ['Weak', 'Fair', 'Strong'];

            for (let i = 0; i < score; i++)
                bars[i].classList.add(classes[Math.min(score - 1, 2)]);

            label.textContent = pw.length === 0 ? '—' : labels[Math.min(score - 1, 2)];
            label.style.color = score === 1 ? '#f25c5c' : score === 2 ? '#f5a623' : 'var(--teal)';
        }
    </script>
</body>
</html>
