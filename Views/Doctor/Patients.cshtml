@using LaboratoryTestRequestManagementSystem.ViewModel
@model IEnumerable<PatientListViewModel>
@{
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    ViewData["Title"] = "My Patients";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>My Patients</h1>
        <div class="page-sub">Active patient records</div>
    </div>
    <div style="display:flex;gap:10px;">
        <a asp-action="InactivePatients" class="btn btn-ghost btn-sm">
            <i class="fas fa-user-slash"></i> View Inactive
        </a>
        <a asp-action="RegisterPatient" class="btn btn-primary btn-sm">
            <i class="fas fa-user-plus"></i> Register New Patient
        </a>
    </div>
</div>

<div class="card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="fas fa-users"></i></div>
            <h3>No patients found</h3>
            <p>Register a new patient to get started.</p>
            <a asp-action="RegisterPatient" class="btn btn-primary">Register Patient</a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>ID Number</th>
                        <th>Contact</th>
                        <th style="width:180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in Model)
                    {
                        <tr>
                            <td>@patient.FullName</td>
                            <td>@patient.Email</td>
                            <td>@patient.SouthAfricanIdNumber</td>
                            <td>@patient.CellphoneNumber</td>
                            <td>
                                <div style="display:flex;gap:6px;">
                                    <a asp-action="Details" asp-route-id="@patient.Id" class="btn btn-secondary btn-sm">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@patient.Id" class="btn btn-ghost btn-sm">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <form asp-action="Delete" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@patient.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Deactivate this patient?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>