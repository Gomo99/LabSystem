@{
    Layout = null;
    ViewData["Title"] = "Reset Link Sent – NMB-HLabSys";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --navy: #0A1628; --teal: #0ECECE; --teal-dark: #09a8a8;
            --teal-glow: rgba(14,206,206,.18); --white: #FFFFFF;
            --off-white: #e8f0f7; --muted: #7a99bb;
            --card-bg: rgba(15,32,64,.72); --border: rgba(14,206,206,.22);
            --success: #2ecc71;
        }

        html, body {
            height: 100%; font-family: 'Outfit', sans-serif;
            background: var(--navy); color: var(--white);
        }

        .bg-scene {
            position: fixed; inset: 0; z-index: 0;
            background: linear-gradient(135deg, #060e1c, #0A1628 50%, #0d2040);
        }

        .bg-scene::before {
            content: ''; position: absolute;
            width: 600px; height: 600px; top: -100px; left: 50%; transform: translateX(-50%);
            background: radial-gradient(circle, rgba(14,206,206,.09) 0%, transparent 65%);
            animation: pulse 9s ease-in-out infinite alternate;
        }

        @@keyframes pulse {
            from { transform: translateX(-50%) scale(1); }
            to   { transform: translateX(-50%) scale(1.3); }
        }

        .grid-overlay {
            position: fixed; inset: 0; z-index: 0;
            background-image:
                linear-gradient(rgba(14,206,206,.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(14,206,206,.04) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        .page-wrapper {
            position: relative; z-index: 1; height: 100vh;
            display: flex; align-items: center; justify-content: center; padding: 30px 20px;
        }

        .card {
            width: 100%; max-width: 460px;
            background: var(--card-bg); border: 1px solid var(--border);
            border-radius: 24px; padding: 52px 44px;
            backdrop-filter: blur(24px);
            box-shadow: 0 40px 80px rgba(0,0,0,.4);
            text-align: center;
            animation: fadeUp .65s cubic-bezier(.22,1,.36,1) both;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(30px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* Animated checkmark */
        .success-ring {
            width: 90px; height: 90px; border-radius: 50%;
            background: rgba(46,204,113,.1);
            border: 2px solid rgba(46,204,113,.35);
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 30px;
            animation: ringPop .5s .15s cubic-bezier(.22,1,.36,1) both;
        }

        @@keyframes ringPop {
            from { opacity: 0; transform: scale(.6); }
            to   { opacity: 1; transform: scale(1); }
        }

        .success-ring i {
            font-size: 36px; color: var(--success);
            animation: checkBounce .4s .4s cubic-bezier(.22,1,.36,1) both;
        }

        @@keyframes checkBounce {
            from { opacity: 0; transform: scale(.5); }
            to   { opacity: 1; transform: scale(1); }
        }

        h2 { font-size: 1.6rem; font-weight: 700; margin-bottom: 12px; }

        .body-text {
            font-size: .9rem; color: var(--muted); line-height: 1.7;
            margin-bottom: 32px;
        }

        .body-text strong { color: var(--off-white); }

        /* Step hints */
        .steps-list {
            background: rgba(14,206,206,.05); border: 1px solid rgba(14,206,206,.14);
            border-radius: 14px; padding: 20px 22px;
            text-align: left; margin-bottom: 32px;
            display: flex; flex-direction: column; gap: 14px;
        }

        .step-hint {
            display: flex; align-items: center; gap: 14px;
        }

        .step-num {
            width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
            background: rgba(14,206,206,.15); border: 1.5px solid rgba(14,206,206,.3);
            display: flex; align-items: center; justify-content: center;
            font-size: .72rem; font-weight: 700; color: var(--teal);
        }

        .step-hint span {
            font-size: .85rem; color: var(--muted); line-height: 1.45;
        }

        .step-hint span strong { color: var(--off-white); font-weight: 500; }

        .btn-primary {
            display: block; width: 100%; padding: 14px; border: none; border-radius: 12px;
            background: linear-gradient(135deg, var(--teal), var(--teal-dark));
            color: var(--navy); font-family: 'Outfit', sans-serif;
            font-size: .98rem; font-weight: 700; cursor: pointer;
            text-decoration: none; transition: transform .15s, box-shadow .25s, filter .2s;
            box-shadow: 0 4px 24px rgba(14,206,206,.35);
            margin-bottom: 18px;
        }

        .btn-primary:hover {
            transform: translateY(-2px); filter: brightness(1.06);
            box-shadow: 0 8px 32px rgba(14,206,206,.5);
        }

        .retry-link {
            font-size: .86rem; color: var(--muted); text-decoration: none;
            transition: color .2s; display: inline-block;
        }

        .retry-link:hover { color: var(--teal); }
    </style>
</head>
<body>
    <div class="bg-scene"></div>
    <div class="grid-overlay"></div>

    <div class="page-wrapper">
        <div class="card">

            <div class="success-ring">
                <i class="fas fa-envelope-circle-check"></i>
            </div>

            <h2>Check your inbox</h2>
            <p class="body-text">
                If that e-mail address is registered with us, you'll receive a password reset link shortly.
                <br><strong>Please check your spam folder</strong> if it doesn't arrive within a few minutes.
            </p>

            <div class="steps-list">
                <div class="step-hint">
                    <div class="step-num">1</div>
                    <span>Open the e-mail from <strong>NMB-HLabSys</strong> in your inbox</span>
                </div>
                <div class="step-hint">
                    <div class="step-num">2</div>
                    <span>Click the <strong>Reset Password</strong> link in the e-mail</span>
                </div>
                <div class="step-hint">
                    <div class="step-num">3</div>
                    <span>Enter a new password — the link expires in <strong>1 hour</strong></span>
                </div>
            </div>

            <a asp-action="Login" asp-controller="Account" class="btn-primary">
                <i class="fas fa-arrow-right-to-bracket" style="margin-right:8px;"></i>Return to Sign In
            </a>

            <a asp-action="ForgotPassword" asp-controller="Account" class="retry-link">
                <i class="fas fa-rotate-left" style="margin-right:6px;"></i>Send again with a different e-mail
            </a>
        </div>
    </div>
</body>
</html>
