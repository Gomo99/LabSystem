@model LaboratoryTestRequestManagementSystem.ViewModel.ResetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Reset Password – NMB-HLabSys";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --navy: #0A1628; --navy-mid: #0F2040;
            --teal: #0ECECE; --teal-dark: #09a8a8;
            --teal-glow: rgba(14,206,206,.18);
            --white: #FFFFFF; --off-white: #e8f0f7;
            --muted: #7a99bb; --danger: #f25c5c;
            --card-bg: rgba(15,32,64,.72); --border: rgba(14,206,206,.22);
        }

        html, body {
            height: 100%; font-family: 'Outfit', sans-serif;
            background: var(--navy); color: var(--white);
        }

        .bg-scene {
            position: fixed; inset: 0; z-index: 0;
            background: linear-gradient(135deg, #060e1c, #0A1628 50%, #0d2040);
        }

        .bg-scene::before {
            content: ''; position: absolute;
            width: 600px; height: 600px; top: -100px; left: 50%; transform: translateX(-50%);
            background: radial-gradient(circle, rgba(14,206,206,.09) 0%, transparent 65%);
            animation: pulse 9s ease-in-out infinite alternate;
        }

        @@keyframes pulse {
            from { transform: translateX(-50%) scale(1); }
            to   { transform: translateX(-50%) scale(1.3); }
        }

        .grid-overlay {
            position: fixed; inset: 0; z-index: 0;
            background-image:
                linear-gradient(rgba(14,206,206,.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(14,206,206,.04) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        .page-wrapper {
            position: relative; z-index: 1; min-height: 100vh;
            display: flex; align-items: center; justify-content: center; padding: 40px 20px;
        }

        .card {
            width: 100%; max-width: 460px;
            background: var(--card-bg); border: 1px solid var(--border);
            border-radius: 24px; padding: 48px 44px;
            backdrop-filter: blur(24px);
            box-shadow: 0 40px 80px rgba(0,0,0,.4), 0 0 0 1px rgba(255,255,255,.04);
            animation: fadeUp .6s cubic-bezier(.22,1,.36,1) both;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(28px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .icon-ring {
            width: 70px; height: 70px; border-radius: 50%;
            background: rgba(14,206,206,.1); border: 2px solid rgba(14,206,206,.28);
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 26px;
        }

        .icon-ring i { font-size: 28px; color: var(--teal); }

        h2 { text-align: center; font-size: 1.6rem; font-weight: 700; margin-bottom: 8px; }

        .subtitle {
            text-align: center; font-size: .88rem; color: var(--muted);
            line-height: 1.65; margin-bottom: 34px;
        }

        /* ── Requirements checklist ── */
        .req-list {
            display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
            background: rgba(14,206,206,.05); border: 1px solid rgba(14,206,206,.14);
            border-radius: 12px; padding: 16px; margin-bottom: 28px;
        }

        .req-item {
            display: flex; align-items: center; gap: 8px;
            font-size: .78rem; color: var(--muted); transition: color .3s;
        }

        .req-item i { font-size: .72rem; transition: color .3s; color: rgba(255,255,255,.2); }

        .req-item.met { color: var(--teal); }
        .req-item.met i { color: var(--teal); }

        .form-group { margin-bottom: 20px; }

        .form-label {
            display: block; font-size: .77rem; font-weight: 600;
            letter-spacing: .07em; text-transform: uppercase;
            color: var(--muted); margin-bottom: 8px;
        }

        .input-wrap { position: relative; }

        .input-icon {
            position: absolute; left: 15px; top: 50%; transform: translateY(-50%);
            color: var(--muted); font-size: .85rem; pointer-events: none; transition: color .2s;
        }

        .input-wrap:focus-within .input-icon { color: var(--teal); }

        .toggle-pw {
            position: absolute; right: 13px; top: 50%; transform: translateY(-50%);
            background: none; border: none; color: var(--muted);
            cursor: pointer; font-size: .85rem; padding: 4px; transition: color .2s;
        }

        .toggle-pw:hover { color: var(--teal); }

        .form-control {
            width: 100%; padding: 13px 44px 13px 44px;
            background: rgba(255,255,255,.05); border: 1.5px solid rgba(255,255,255,.1);
            border-radius: 12px; color: var(--white);
            font-family: 'Outfit', sans-serif; font-size: .93rem; outline: none;
            transition: border-color .25s, box-shadow .25s, background .25s;
        }

        .form-control:focus {
            border-color: var(--teal); background: rgba(14,206,206,.05);
            box-shadow: 0 0 0 4px rgba(14,206,206,.12);
        }

        .form-control::placeholder { color: rgba(255,255,255,.22); }

        .text-danger { font-size: .78rem; color: var(--danger); margin-top: 5px; display: block; }

        .validation-summary-errors {
            background: rgba(242,92,92,.08); border: 1px solid rgba(242,92,92,.3);
            border-radius: 10px; padding: 12px 16px; margin-bottom: 20px;
        }

        .validation-summary-errors ul { list-style: none; }
        .validation-summary-errors ul li { font-size: .84rem; color: var(--danger); }
        .validation-summary-errors ul li::before { content: '⚠  '; }

        /* Strength bar */
        .pw-strength { margin-top: 8px; display: flex; gap: 5px; align-items: center; }

        .pw-strength .bar {
            flex: 1; height: 3px; border-radius: 3px;
            background: rgba(255,255,255,.08); transition: background .3s;
        }

        .pw-strength .bar.weak   { background: #f25c5c; }
        .pw-strength .bar.medium { background: #f5a623; }
        .pw-strength .bar.strong { background: var(--teal); }

        .pw-strength .pw-text {
            font-size: .72rem; color: var(--muted); min-width: 48px; text-align: right;
        }

        .btn-primary {
            width: 100%; padding: 14px; border: none; border-radius: 12px;
            background: linear-gradient(135deg, var(--teal), var(--teal-dark));
            color: var(--navy); font-family: 'Outfit', sans-serif;
            font-size: .98rem; font-weight: 700; cursor: pointer;
            transition: transform .15s, box-shadow .25s, filter .2s;
            box-shadow: 0 4px 24px rgba(14,206,206,.35);
            margin-top: 8px; margin-bottom: 20px;
        }

        .btn-primary:hover {
            transform: translateY(-2px); filter: brightness(1.06);
            box-shadow: 0 8px 32px rgba(14,206,206,.5);
        }

        .back-link {
            display: flex; align-items: center; justify-content: center; gap: 8px;
            font-size: .88rem; color: var(--muted); text-decoration: none; transition: color .2s;
        }

        .back-link:hover { color: var(--teal); }
    </style>
</head>
<body>
    <div class="bg-scene"></div>
    <div class="grid-overlay"></div>

    <div class="page-wrapper">
        <div class="card">

            <div class="icon-ring"><i class="fas fa-shield-halved"></i></div>
            <h2>Set New Password</h2>
            <p class="subtitle">Choose a strong password for your NMB-HLabSys account.</p>

            <!-- Requirements live checklist -->
            <div class="req-list" id="reqList">
                <div class="req-item" id="req-len"><i class="fas fa-circle-check"></i> 8+ characters</div>
                <div class="req-item" id="req-upper"><i class="fas fa-circle-check"></i> Uppercase letter</div>
                <div class="req-item" id="req-num"><i class="fas fa-circle-check"></i> Number</div>
                <div class="req-item" id="req-special"><i class="fas fa-circle-check"></i> Special character</div>
            </div>

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" id="valSummary"></div>

            <form asp-action="ResetPassword" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <!-- New Password -->
                <div class="form-group">
                    <label asp-for="Password" class="form-label">New Password</label>
                    <div class="input-wrap">
                        <i class="fas fa-lock input-icon"></i>
                        <input asp-for="Password" type="password" id="newPw"
                               class="form-control" placeholder="••••••••"
                               oninput="updateRequirements(this.value)"
                               autocomplete="new-password" />
                        <button type="button" class="toggle-pw" onclick="togglePw('newPw','icon1')">
                            <i class="fas fa-eye" id="icon1"></i>
                        </button>
                    </div>
                    <div class="pw-strength">
                        <div class="bar" id="sb1"></div>
                        <div class="bar" id="sb2"></div>
                        <div class="bar" id="sb3"></div>
                        <span class="pw-text" id="sLabel">—</span>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <!-- Confirm Password -->
                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                    <div class="input-wrap">
                        <i class="fas fa-lock input-icon"></i>
                        <input asp-for="ConfirmPassword" type="password" id="confirmPw"
                               class="form-control" placeholder="••••••••"
                               autocomplete="new-password" />
                        <button type="button" class="toggle-pw" onclick="togglePw('confirmPw','icon2')">
                            <i class="fas fa-eye" id="icon2"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-primary">
                    <i class="fas fa-check-circle" style="margin-right:8px;"></i>Reset Password
                </button>
            </form>

            <a asp-action="Login" asp-controller="Account" class="back-link">
                <i class="fas fa-arrow-left"></i> Back to Sign In
            </a>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const vs = document.querySelector('#valSummary ul');
            if (!vs || vs.children.length === 0)
                document.getElementById('valSummary').style.display = 'none';
        });

        function togglePw(id, iconId) {
            const inp = document.getElementById(id);
            const ic = document.getElementById(iconId);
            inp.type = inp.type === 'password' ? 'text' : 'password';
            ic.className = inp.type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
        }

        function updateRequirements(pw) {
            toggle('req-len',     pw.length >= 8);
            toggle('req-upper',   /[A-Z]/.test(pw));
            toggle('req-num',     /\d/.test(pw));
            toggle('req-special', /[^a-zA-Z0-9\s]/.test(pw));

            // Strength bar
            let score = 0;
            if (pw.length >= 8)                     score++;
            if (/[A-Z]/.test(pw) && /\d/.test(pw)) score++;
            if (/[^a-zA-Z0-9\s]/.test(pw))         score++;

            ['sb1','sb2','sb3'].forEach((id, i) => {
                const el = document.getElementById(id);
                el.className = 'bar';
                if (i < score) el.classList.add(['weak','medium','strong'][Math.min(score-1,2)]);
            });

            const label = document.getElementById('sLabel');
            label.textContent = pw.length === 0 ? '—' : ['Weak','Fair','Strong'][Math.min(score-1,2)];
            label.style.color = score === 1 ? '#f25c5c' : score === 2 ? '#f5a623' : 'var(--teal)';
        }

        function toggle(id, met) {
            const el = document.getElementById(id);
            el.classList.toggle('met', met);
        }
    </script>
</body>
</html>
