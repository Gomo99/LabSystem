@model LaboratoryTestRequestManagementSystem.ViewModel.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Forgot Password – NMB-HLabSys";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --navy: #0A1628; --navy-mid: #0F2040;
            --teal: #0ECECE; --teal-dark: #09a8a8;
            --teal-glow: rgba(14,206,206,.18);
            --white: #FFFFFF; --off-white: #e8f0f7;
            --muted: #7a99bb; --danger: #f25c5c;
            --card-bg: rgba(15,32,64,.72);
            --border: rgba(14,206,206,.22);
        }

        html, body {
            height: 100%; font-family: 'Outfit', sans-serif;
            background: var(--navy); color: var(--white);
        }

        .bg-scene {
            position: fixed; inset: 0; z-index: 0;
            background: linear-gradient(135deg, #060e1c, #0A1628 50%, #0d2040);
        }

        .bg-scene::before {
            content: ''; position: absolute;
            width: 550px; height: 550px; top: -100px; left: 50%; transform: translateX(-50%);
            background: radial-gradient(circle, rgba(14,206,206,.1) 0%, transparent 70%);
            animation: pulse 10s ease-in-out infinite alternate;
        }

        @@keyframes pulse {
            from { transform: translateX(-50%) scale(1); }
            to   { transform: translateX(-50%) scale(1.3); }
        }

        .grid-overlay {
            position: fixed; inset: 0; z-index: 0;
            background-image:
                linear-gradient(rgba(14,206,206,.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(14,206,206,.04) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        .page-wrapper {
            position: relative; z-index: 1; min-height: 100vh;
            display: flex; align-items: center; justify-content: center; padding: 40px 20px;
        }

        .card {
            width: 100%; max-width: 460px;
            background: var(--card-bg); border: 1px solid var(--border);
            border-radius: 24px; padding: 48px 44px;
            backdrop-filter: blur(24px);
            box-shadow: 0 40px 80px rgba(0,0,0,.4), 0 0 0 1px rgba(255,255,255,.04);
            animation: fadeUp .6s cubic-bezier(.22,1,.36,1) both;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(28px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* icon ring */
        .icon-ring {
            width: 72px; height: 72px; border-radius: 50%;
            background: rgba(14,206,206,.1); border: 2px solid rgba(14,206,206,.3);
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 28px;
            animation: ringPulse 3s ease-in-out infinite;
        }

        .icon-ring i { font-size: 28px; color: var(--teal); }

        @@keyframes ringPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(14,206,206,.25); }
            50%       { box-shadow: 0 0 0 12px rgba(14,206,206,.0); }
        }

        h2 { text-align: center; font-size: 1.6rem; font-weight: 700; margin-bottom: 10px; }

        .subtitle {
            text-align: center; font-size: .88rem; color: var(--muted);
            line-height: 1.65; margin-bottom: 36px;
        }

        .form-group { margin-bottom: 22px; }

        .form-label {
            display: block; font-size: .77rem; font-weight: 600;
            letter-spacing: .07em; text-transform: uppercase;
            color: var(--muted); margin-bottom: 8px;
        }

        .input-wrap { position: relative; }

        .input-icon {
            position: absolute; left: 15px; top: 50%; transform: translateY(-50%);
            color: var(--muted); font-size: .85rem; pointer-events: none;
            transition: color .2s;
        }

        .input-wrap:focus-within .input-icon { color: var(--teal); }

        .form-control {
            width: 100%; padding: 13px 14px 13px 44px;
            background: rgba(255,255,255,.05); border: 1.5px solid rgba(255,255,255,.1);
            border-radius: 12px; color: var(--white);
            font-family: 'Outfit', sans-serif; font-size: .93rem; outline: none;
            transition: border-color .25s, box-shadow .25s, background .25s;
        }

        .form-control:focus {
            border-color: var(--teal); background: rgba(14,206,206,.05);
            box-shadow: 0 0 0 4px rgba(14,206,206,.12);
        }

        .form-control::placeholder { color: rgba(255,255,255,.22); }

        .text-danger { font-size: .78rem; color: var(--danger); margin-top: 5px; display: block; }

        .validation-summary-errors {
            background: rgba(242,92,92,.08); border: 1px solid rgba(242,92,92,.3);
            border-radius: 10px; padding: 12px 16px; margin-bottom: 20px;
        }

        .validation-summary-errors ul { list-style: none; }
        .validation-summary-errors ul li { font-size: .84rem; color: var(--danger); }
        .validation-summary-errors ul li::before { content: '⚠  '; }

        .btn-primary {
            width: 100%; padding: 14px; border: none; border-radius: 12px;
            background: linear-gradient(135deg, var(--teal), var(--teal-dark));
            color: var(--navy); font-family: 'Outfit', sans-serif;
            font-size: .98rem; font-weight: 700; cursor: pointer;
            transition: transform .15s, box-shadow .25s, filter .2s;
            box-shadow: 0 4px 24px rgba(14,206,206,.35);
            margin-bottom: 20px;
        }

        .btn-primary:hover {
            transform: translateY(-2px); filter: brightness(1.06);
            box-shadow: 0 8px 32px rgba(14,206,206,.5);
        }

        .back-link {
            display: flex; align-items: center; justify-content: center; gap: 8px;
            font-size: .88rem; color: var(--muted); text-decoration: none;
            transition: color .2s;
        }

        .back-link:hover { color: var(--teal); }

        /* info box */
        .info-box {
            background: rgba(14,206,206,.06); border: 1px solid rgba(14,206,206,.15);
            border-radius: 11px; padding: 13px 16px;
            font-size: .82rem; color: var(--muted); line-height: 1.65;
            margin-bottom: 28px; display: flex; gap: 10px; align-items: flex-start;
        }

        .info-box i { color: var(--teal); margin-top: 2px; flex-shrink: 0; }
    </style>
</head>
<body>
    <div class="bg-scene"></div>
    <div class="grid-overlay"></div>

    <div class="page-wrapper">
        <div class="card">

            <div class="icon-ring"><i class="fas fa-key"></i></div>

            <h2>Forgot Password?</h2>
            <p class="subtitle">
                Enter the e-mail address linked to your account and we'll send you a secure reset link.
            </p>

            <div class="info-box">
                <i class="fas fa-circle-info"></i>
                <span>The reset link is valid for <strong style="color:var(--off-white);">1 hour</strong>. Check your spam folder if you don't receive it within a few minutes.</span>
            </div>

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" id="valSummary"></div>

            <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label asp-for="Email" class="form-label">E-mail Address</label>
                    <div class="input-wrap">
                        <i class="fas fa-envelope input-icon"></i>
                        <input asp-for="Email" type="email" class="form-control"
                               placeholder="you@example.com" autofocus autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-primary">
                    <i class="fas fa-paper-plane" style="margin-right:8px;"></i>Send Reset Link
                </button>
            </form>

            <a asp-action="Login" asp-controller="Account" class="back-link">
                <i class="fas fa-arrow-left"></i> Back to Sign In
            </a>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const vs = document.querySelector('#valSummary ul');
            if (!vs || vs.children.length === 0)
                document.getElementById('valSummary').style.display = 'none';
        });
    </script>
</body>
</html>
