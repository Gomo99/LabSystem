@model LaboratoryTestRequestManagementSystem.ViewModel.ChangePasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Change Password – NMB-HLabSys";
    var firstName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "User";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --navy: #0A1628; --navy-mid: #0F2040;
            --teal: #0ECECE; --teal-dark: #09a8a8;
            --teal-glow: rgba(14,206,206,.18);
            --white: #FFFFFF; --off-white: #e8f0f7;
            --muted: #7a99bb; --danger: #f25c5c;
            --success: #2ecc71;
            --card-bg: rgba(15,32,64,.72); --border: rgba(14,206,206,.22);
        }

        html, body {
            min-height: 100%; font-family: 'Outfit', sans-serif;
            background: var(--navy); color: var(--white);
        }

        .bg-scene {
            position: fixed; inset: 0; z-index: 0;
            background: linear-gradient(135deg, #060e1c, #0A1628 55%, #0d2040);
        }

        .bg-scene::before {
            content: ''; position: absolute;
            width: 700px; height: 700px; top: -200px; right: -200px;
            background: radial-gradient(circle, rgba(14,206,206,.09) 0%, transparent 65%);
            animation: pulse 10s ease-in-out infinite alternate;
        }

        @@keyframes pulse {
            from { transform: scale(1); }
            to   { transform: scale(1.2); }
        }

        .grid-overlay {
            position: fixed; inset: 0; z-index: 0;
            background-image:
                linear-gradient(rgba(14,206,206,.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(14,206,206,.04) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        .page-wrapper {
            position: relative; z-index: 1; min-height: 100vh;
            display: flex; align-items: center; justify-content: center; padding: 40px 20px;
        }

        .card {
            width: 100%; max-width: 500px;
            background: var(--card-bg); border: 1px solid var(--border);
            border-radius: 24px; padding: 48px 44px;
            backdrop-filter: blur(24px);
            box-shadow: 0 40px 80px rgba(0,0,0,.4), 0 0 0 1px rgba(255,255,255,.04);
            animation: fadeUp .6s cubic-bezier(.22,1,.36,1) both;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(28px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ── HEADER ── */
        .card-header {
            display: flex; align-items: center; gap: 16px;
            margin-bottom: 32px; padding-bottom: 24px;
            border-bottom: 1px solid rgba(255,255,255,.07);
        }

        .header-icon {
            width: 52px; height: 52px; border-radius: 14px; flex-shrink: 0;
            background: linear-gradient(135deg, var(--teal), var(--teal-dark));
            display: flex; align-items: center; justify-content: center;
            font-size: 20px; color: var(--navy);
            box-shadow: 0 0 20px var(--teal-glow);
        }

        .header-text h2 { font-size: 1.45rem; font-weight: 700; margin-bottom: 3px; }
        .header-text p  { font-size: .84rem; color: var(--muted); }

        /* ── SUCCESS BANNER ── */
        .alert-success {
            display: flex; align-items: center; gap: 10px;
            background: rgba(46,204,113,.1); border: 1px solid rgba(46,204,113,.3);
            border-radius: 11px; padding: 13px 16px;
            font-size: .88rem; color: var(--success);
            margin-bottom: 24px;
        }

        /* ── FIRST LOGIN NOTICE ── */
        .first-login-notice {
            display: flex; align-items: flex-start; gap: 12px;
            background: rgba(245,166,35,.08); border: 1px solid rgba(245,166,35,.3);
            border-radius: 11px; padding: 14px 16px;
            margin-bottom: 26px;
        }

        .first-login-notice i { color: #f5a623; margin-top: 2px; flex-shrink: 0; }

        .first-login-notice .notice-text {
            font-size: .85rem; color: var(--muted); line-height: 1.6;
        }

        .first-login-notice .notice-text strong { color: var(--off-white); }

        /* ── FORM ── */
        .form-group { margin-bottom: 22px; }

        .form-label {
            display: block; font-size: .77rem; font-weight: 600;
            letter-spacing: .07em; text-transform: uppercase;
            color: var(--muted); margin-bottom: 8px;
        }

        .input-wrap { position: relative; }

        .input-icon {
            position: absolute; left: 15px; top: 50%; transform: translateY(-50%);
            color: var(--muted); font-size: .85rem; pointer-events: none; transition: color .2s;
        }

        .input-wrap:focus-within .input-icon { color: var(--teal); }

        .toggle-pw {
            position: absolute; right: 13px; top: 50%; transform: translateY(-50%);
            background: none; border: none; color: var(--muted);
            cursor: pointer; font-size: .85rem; padding: 4px; transition: color .2s;
        }

        .toggle-pw:hover { color: var(--teal); }

        .form-control {
            width: 100%; padding: 13px 44px 13px 44px;
            background: rgba(255,255,255,.05); border: 1.5px solid rgba(255,255,255,.1);
            border-radius: 12px; color: var(--white);
            font-family: 'Outfit', sans-serif; font-size: .93rem; outline: none;
            transition: border-color .25s, box-shadow .25s, background .25s;
        }

        .form-control:focus {
            border-color: var(--teal); background: rgba(14,206,206,.05);
            box-shadow: 0 0 0 4px rgba(14,206,206,.12);
        }

        .form-control::placeholder { color: rgba(255,255,255,.22); }

        .text-danger { font-size: .78rem; color: var(--danger); margin-top: 5px; display: block; }

        .validation-summary-errors {
            background: rgba(242,92,92,.08); border: 1px solid rgba(242,92,92,.3);
            border-radius: 10px; padding: 12px 16px; margin-bottom: 20px;
        }

        .validation-summary-errors ul { list-style: none; }
        .validation-summary-errors ul li { font-size: .84rem; color: var(--danger); }
        .validation-summary-errors ul li::before { content: '⚠  '; }

        /* Strength bar */
        .pw-strength { margin-top: 8px; display: flex; gap: 5px; align-items: center; }
        .pw-strength .bar { flex: 1; height: 3px; border-radius: 3px; background: rgba(255,255,255,.08); transition: background .3s; }
        .pw-strength .bar.weak   { background: #f25c5c; }
        .pw-strength .bar.medium { background: #f5a623; }
        .pw-strength .bar.strong { background: var(--teal); }
        .pw-strength .pw-text { font-size: .72rem; color: var(--muted); min-width: 48px; text-align: right; }

        /* Divider */
        .divider {
            height: 1px; background: rgba(255,255,255,.07);
            margin: 28px 0;
        }

        /* Req checklist */
        .req-grid {
            display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
            background: rgba(14,206,206,.05); border: 1px solid rgba(14,206,206,.13);
            border-radius: 11px; padding: 14px; margin-bottom: 22px;
        }

        .req-item { display: flex; align-items: center; gap: 7px; font-size: .78rem; color: var(--muted); transition: color .3s; }
        .req-item i { font-size: .72rem; color: rgba(255,255,255,.18); transition: color .3s; }
        .req-item.met { color: var(--teal); }
        .req-item.met i { color: var(--teal); }

        /* Buttons */
        .btn-row { display: flex; gap: 14px; margin-top: 8px; }

        .btn-primary {
            flex: 1; padding: 13px; border: none; border-radius: 12px;
            background: linear-gradient(135deg, var(--teal), var(--teal-dark));
            color: var(--navy); font-family: 'Outfit', sans-serif;
            font-size: .95rem; font-weight: 700; cursor: pointer;
            transition: transform .15s, box-shadow .25s, filter .2s;
            box-shadow: 0 4px 24px rgba(14,206,206,.35);
        }

        .btn-primary:hover {
            transform: translateY(-2px); filter: brightness(1.06);
            box-shadow: 0 8px 32px rgba(14,206,206,.5);
        }

        .btn-ghost {
            padding: 13px 20px; border: 1.5px solid rgba(255,255,255,.12); border-radius: 12px;
            background: transparent; color: var(--muted);
            font-family: 'Outfit', sans-serif; font-size: .95rem; font-weight: 500;
            cursor: pointer; text-decoration: none; display: flex; align-items: center; gap: 7px;
            transition: border-color .2s, color .2s;
        }

        .btn-ghost:hover { border-color: rgba(14,206,206,.4); color: var(--teal); }
    </style>
</head>
<body>
    <div class="bg-scene"></div>
    <div class="grid-overlay"></div>

    <div class="page-wrapper">
        <div class="card">

            <div class="card-header">
                <div class="header-icon"><i class="fas fa-lock"></i></div>
                <div class="header-text">
                    <h2>Change Password</h2>
                    <p>Hello, @firstName — update your account password below</p>
                </div>
            </div>

            @if (TempData["Message"] != null)
            {
                <div class="alert-success">
                    <i class="fas fa-circle-check"></i>
                    @TempData["Message"]
                </div>
            }

            @if (ViewBag.MustChange == true)
            {
                <div class="first-login-notice">
                    <i class="fas fa-triangle-exclamation"></i>
                    <div class="notice-text">
                        <strong>Action required:</strong> You must change your auto-generated password before continuing. Please choose a new secure password.
                    </div>
                </div>
            }

            <!-- Password requirements checklist -->
            <div class="req-grid" id="reqGrid">
                <div class="req-item" id="req-len"><i class="fas fa-circle-check"></i> 8+ characters</div>
                <div class="req-item" id="req-upper"><i class="fas fa-circle-check"></i> Uppercase letter</div>
                <div class="req-item" id="req-num"><i class="fas fa-circle-check"></i> Number</div>
                <div class="req-item" id="req-special"><i class="fas fa-circle-check"></i> Special character</div>
            </div>

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" id="valSummary"></div>

            <form asp-action="ChangePassword" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()

                <!-- Current Password -->
                <div class="form-group">
                    <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                    <div class="input-wrap">
                        <i class="fas fa-lock-open input-icon"></i>
                        <input asp-for="CurrentPassword" type="password" id="curPw"
                               class="form-control" placeholder="Your current password"
                               autocomplete="current-password" />
                        <button type="button" class="toggle-pw" onclick="togglePw('curPw','ic0')">
                            <i class="fas fa-eye" id="ic0"></i>
                        </button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <div class="divider"></div>

                <!-- New Password -->
                <div class="form-group">
                    <label asp-for="NewPassword" class="form-label">New Password</label>
                    <div class="input-wrap">
                        <i class="fas fa-lock input-icon"></i>
                        <input asp-for="NewPassword" type="password" id="newPw"
                               class="form-control" placeholder="••••••••"
                               oninput="updateReq(this.value)"
                               autocomplete="new-password" />
                        <button type="button" class="toggle-pw" onclick="togglePw('newPw','ic1')">
                            <i class="fas fa-eye" id="ic1"></i>
                        </button>
                    </div>
                    <div class="pw-strength">
                        <div class="bar" id="sb1"></div>
                        <div class="bar" id="sb2"></div>
                        <div class="bar" id="sb3"></div>
                        <span class="pw-text" id="sLabel">—</span>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <!-- Confirm New Password -->
                <div class="form-group">
                    <label asp-for="ConfirmNewPassword" class="form-label">Confirm New Password</label>
                    <div class="input-wrap">
                        <i class="fas fa-lock input-icon"></i>
                        <input asp-for="ConfirmNewPassword" type="password" id="confPw"
                               class="form-control" placeholder="••••••••"
                               autocomplete="new-password" />
                        <button type="button" class="toggle-pw" onclick="togglePw('confPw','ic2')">
                            <i class="fas fa-eye" id="ic2"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                </div>

                <div class="btn-row">
                    <a asp-action="Dashboard" class="btn-ghost">
                        <i class="fas fa-arrow-left"></i> Cancel
                    </a>
                    <button type="submit" class="btn-primary">
                        <i class="fas fa-check" style="margin-right:7px;"></i>Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const vs = document.querySelector('#valSummary ul');
            if (!vs || vs.children.length === 0)
                document.getElementById('valSummary').style.display = 'none';
        });

        function togglePw(id, iconId) {
            const inp = document.getElementById(id);
            const ic = document.getElementById(iconId);
            inp.type = inp.type === 'password' ? 'text' : 'password';
            ic.className = inp.type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
        }

        function updateReq(pw) {
            setReq('req-len',     pw.length >= 8);
            setReq('req-upper',   /[A-Z]/.test(pw));
            setReq('req-num',     /\d/.test(pw));
            setReq('req-special', /[^a-zA-Z0-9\s]/.test(pw));

            let score = 0;
            if (pw.length >= 8) score++;
            if (/[A-Z]/.test(pw) && /\d/.test(pw)) score++;
            if (/[^a-zA-Z0-9\s]/.test(pw)) score++;

            ['sb1','sb2','sb3'].forEach((id, i) => {
                const el = document.getElementById(id);
                el.className = 'bar';
                if (i < score) el.classList.add(['weak','medium','strong'][Math.min(score-1,2)]);
            });

            const lbl = document.getElementById('sLabel');
            lbl.textContent = pw.length === 0 ? '—' : ['Weak','Fair','Strong'][Math.min(score-1,2)];
            lbl.style.color = score === 1 ? '#f25c5c' : score === 2 ? '#f5a623' : 'var(--teal)';
        }

        function setReq(id, met) {
            document.getElementById(id).classList.toggle('met', met);
        }
    </script>
</body>
</html>
