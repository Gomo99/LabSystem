@model LaboratoryTestRequestManagementSystem.ViewModel.ChangeUsernameViewModel
@{
    Layout = null;
    ViewData["Title"] = "Change Username – NMB-HLabSys";
    var firstName  = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "User";
    var currentEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --navy: #0A1628; --navy-mid: #0F2040;
            --teal: #0ECECE; --teal-dark: #09a8a8;
            --teal-glow: rgba(14,206,206,.18);
            --white: #FFFFFF; --off-white: #e8f0f7;
            --muted: #7a99bb; --danger: #f25c5c;
            --success: #2ecc71;
            --card-bg: rgba(15,32,64,.72); --border: rgba(14,206,206,.22);
        }

        html, body {
            min-height: 100%; font-family: 'Outfit', sans-serif;
            background: var(--navy); color: var(--white);
        }

        .bg-scene {
            position: fixed; inset: 0; z-index: 0;
            background: linear-gradient(135deg, #060e1c, #0A1628 55%, #0d2040);
        }

        .bg-scene::before {
            content: ''; position: absolute;
            width: 600px; height: 600px; bottom: -150px; left: -150px;
            background: radial-gradient(circle, rgba(14,206,206,.09) 0%, transparent 65%);
            animation: pulse 10s ease-in-out infinite alternate;
        }

        @@keyframes pulse {
            from { transform: scale(1); }
            to   { transform: scale(1.25); }
        }

        .grid-overlay {
            position: fixed; inset: 0; z-index: 0;
            background-image:
                linear-gradient(rgba(14,206,206,.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(14,206,206,.04) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        .page-wrapper {
            position: relative; z-index: 1; min-height: 100vh;
            display: flex; align-items: center; justify-content: center; padding: 40px 20px;
        }

        .card {
            width: 100%; max-width: 480px;
            background: var(--card-bg); border: 1px solid var(--border);
            border-radius: 24px; padding: 48px 44px;
            backdrop-filter: blur(24px);
            box-shadow: 0 40px 80px rgba(0,0,0,.4), 0 0 0 1px rgba(255,255,255,.04);
            animation: fadeUp .6s cubic-bezier(.22,1,.36,1) both;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(28px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .card-header {
            display: flex; align-items: center; gap: 16px;
            margin-bottom: 30px; padding-bottom: 22px;
            border-bottom: 1px solid rgba(255,255,255,.07);
        }

        .header-icon {
            width: 52px; height: 52px; border-radius: 14px; flex-shrink: 0;
            background: linear-gradient(135deg, var(--teal), var(--teal-dark));
            display: flex; align-items: center; justify-content: center;
            font-size: 20px; color: var(--navy);
            box-shadow: 0 0 20px var(--teal-glow);
        }

        .header-text h2 { font-size: 1.45rem; font-weight: 700; margin-bottom: 3px; }
        .header-text p  { font-size: .84rem; color: var(--muted); }

        /* current email display */
        .current-email-box {
            background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08);
            border-radius: 12px; padding: 14px 18px;
            margin-bottom: 28px;
            display: flex; align-items: center; gap: 12px;
        }

        .current-email-box .email-tag {
            font-size: .72rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase;
            color: var(--muted); margin-bottom: 3px;
        }

        .current-email-box .email-val {
            font-size: .94rem; color: var(--off-white); font-weight: 500;
        }

        .current-email-box i { color: var(--muted); font-size: 1.1rem; flex-shrink: 0; }

        /* info box */
        .info-box {
            background: rgba(14,206,206,.06); border: 1px solid rgba(14,206,206,.15);
            border-radius: 11px; padding: 13px 16px;
            font-size: .82rem; color: var(--muted); line-height: 1.65;
            margin-bottom: 26px; display: flex; gap: 10px; align-items: flex-start;
        }

        .info-box i { color: var(--teal); margin-top: 2px; flex-shrink: 0; }

        /* Success banner */
        .alert-success {
            display: flex; align-items: center; gap: 10px;
            background: rgba(46,204,113,.1); border: 1px solid rgba(46,204,113,.3);
            border-radius: 11px; padding: 13px 16px;
            font-size: .88rem; color: var(--success); margin-bottom: 22px;
        }

        /* Form */
        .form-group { margin-bottom: 20px; }

        .form-label {
            display: block; font-size: .77rem; font-weight: 600;
            letter-spacing: .07em; text-transform: uppercase;
            color: var(--muted); margin-bottom: 8px;
        }

        .input-wrap { position: relative; }

        .input-icon {
            position: absolute; left: 15px; top: 50%; transform: translateY(-50%);
            color: var(--muted); font-size: .85rem; pointer-events: none; transition: color .2s;
        }

        .input-wrap:focus-within .input-icon { color: var(--teal); }

        .form-control {
            width: 100%; padding: 13px 14px 13px 44px;
            background: rgba(255,255,255,.05); border: 1.5px solid rgba(255,255,255,.1);
            border-radius: 12px; color: var(--white);
            font-family: 'Outfit', sans-serif; font-size: .93rem; outline: none;
            transition: border-color .25s, box-shadow .25s, background .25s;
        }

        .form-control:focus {
            border-color: var(--teal); background: rgba(14,206,206,.05);
            box-shadow: 0 0 0 4px rgba(14,206,206,.12);
        }

        .form-control::placeholder { color: rgba(255,255,255,.22); }

        /* live match indicator */
        .match-row {
            display: flex; align-items: center; gap: 7px;
            font-size: .78rem; margin-top: 6px;
            color: var(--muted); transition: color .3s;
        }

        .match-row.match { color: var(--success); }
        .match-row.no-match { color: var(--danger); }

        .text-danger { font-size: .78rem; color: var(--danger); margin-top: 5px; display: block; }

        .validation-summary-errors {
            background: rgba(242,92,92,.08); border: 1px solid rgba(242,92,92,.3);
            border-radius: 10px; padding: 12px 16px; margin-bottom: 20px;
        }

        .validation-summary-errors ul { list-style: none; }
        .validation-summary-errors ul li { font-size: .84rem; color: var(--danger); }
        .validation-summary-errors ul li::before { content: '⚠  '; }

        /* Buttons */
        .btn-row { display: flex; gap: 14px; margin-top: 28px; }

        .btn-primary {
            flex: 1; padding: 13px; border: none; border-radius: 12px;
            background: linear-gradient(135deg, var(--teal), var(--teal-dark));
            color: var(--navy); font-family: 'Outfit', sans-serif;
            font-size: .95rem; font-weight: 700; cursor: pointer;
            transition: transform .15s, box-shadow .25s, filter .2s;
            box-shadow: 0 4px 24px rgba(14,206,206,.35);
        }

        .btn-primary:hover {
            transform: translateY(-2px); filter: brightness(1.06);
            box-shadow: 0 8px 32px rgba(14,206,206,.5);
        }

        .btn-ghost {
            padding: 13px 20px; border: 1.5px solid rgba(255,255,255,.12); border-radius: 12px;
            background: transparent; color: var(--muted);
            font-family: 'Outfit', sans-serif; font-size: .95rem; font-weight: 500;
            cursor: pointer; text-decoration: none; display: flex; align-items: center; gap: 7px;
            transition: border-color .2s, color .2s;
        }

        .btn-ghost:hover { border-color: rgba(14,206,206,.4); color: var(--teal); }
    </style>
</head>
<body>
    <div class="bg-scene"></div>
    <div class="grid-overlay"></div>

    <div class="page-wrapper">
        <div class="card">

            <div class="card-header">
                <div class="header-icon"><i class="fas fa-at"></i></div>
                <div class="header-text">
                    <h2>Change Username</h2>
                    <p>Hello, @firstName — your username is your e-mail address</p>
                </div>
            </div>

            @if (TempData["Message"] != null)
            {
                <div class="alert-success">
                    <i class="fas fa-circle-check"></i>
                    @TempData["Message"]
                </div>
            }

            <!-- Current e-mail display -->
            <div class="current-email-box">
                <i class="fas fa-envelope"></i>
                <div>
                    <div class="email-tag">Current e-mail / username</div>
                    <div class="email-val">@currentEmail</div>
                </div>
            </div>

            <div class="info-box">
                <i class="fas fa-circle-info"></i>
                <span>
                    Your username is used to sign in. Changing it will require you to use the new e-mail address at next login.
                    A confirmation may be sent to your current address.
                </span>
            </div>

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" id="valSummary"></div>

            <form asp-action="ChangeUsername" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label asp-for="NewEmail" class="form-label">New E-mail Address</label>
                    <div class="input-wrap">
                        <i class="fas fa-envelope input-icon"></i>
                        <input asp-for="NewEmail" type="email" id="newEmail"
                               class="form-control" placeholder="newemail@example.com"
                               oninput="checkMatch()"
                               autocomplete="email" autofocus />
                    </div>
                    <span asp-validation-for="NewEmail" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmNewEmail" class="form-label">Confirm New E-mail</label>
                    <div class="input-wrap">
                        <i class="fas fa-envelope input-icon"></i>
                        <input asp-for="ConfirmNewEmail" type="email" id="confEmail"
                               class="form-control" placeholder="Repeat new e-mail"
                               oninput="checkMatch()"
                               autocomplete="email" />
                    </div>
                    <div class="match-row" id="matchRow" style="display:none;">
                        <i class="fas fa-circle-check" id="matchIcon"></i>
                        <span id="matchText"></span>
                    </div>
                    <span asp-validation-for="ConfirmNewEmail" class="text-danger"></span>
                </div>

                <div class="btn-row">
                    <a asp-action="Dashboard" class="btn-ghost">
                        <i class="fas fa-arrow-left"></i> Cancel
                    </a>
                    <button type="submit" class="btn-primary">
                        <i class="fas fa-check" style="margin-right:7px;"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const vs = document.querySelector('#valSummary ul');
            if (!vs || vs.children.length === 0)
                document.getElementById('valSummary').style.display = 'none';
        });

        function checkMatch() {
            const v1 = document.getElementById('newEmail').value;
            const v2 = document.getElementById('confEmail').value;
            const row = document.getElementById('matchRow');
            const icon = document.getElementById('matchIcon');
            const text = document.getElementById('matchText');

            if (!v2) { row.style.display = 'none'; return; }

            row.style.display = 'flex';
            const ok = v1 === v2 && v1 !== '';
            row.className = 'match-row ' + (ok ? 'match' : 'no-match');
            icon.className = ok ? 'fas fa-circle-check' : 'fas fa-circle-xmark';
            text.textContent = ok ? 'E-mail addresses match' : 'E-mail addresses do not match';
        }
    </script>
</body>
</html>
